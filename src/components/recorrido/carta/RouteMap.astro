---
import { createHash } from 'node:crypto';
import { buildRouteMap } from '@/lib/route-map';
import { placeKey } from '@/lib/adapters/trip-adapter';
import type { RouteStop } from '@/lib/adapters/route-adapter';

interface Props {
  stops: RouteStop[];
  /** Para el lector de pantalla: qué muestra el mapa */
  label: string;
  /** Dónde estoy hoy: si es la última parada, su etiqueta dice "hoy" */
  current?: string | null;
}

const { stops, label, current } = Astro.props;
const map = buildRouteMap(stops.map((stop) => stop.coordinates));

type Label = { point: { x: number; y: number }; text: string; class: string };

const first = stops[0];
const last = stops.length > 1 ? stops.at(-1)! : null;
const year = (stop: RouteStop) => stop.date?.slice(0, 4) ?? null;
const isHere = !!last && !!current && placeKey(current) === placeKey(last.city);
const lastWhen = isHere ? 'hoy' : last && year(last);

// La salida va debajo de su punto y la última parada a su derecha, para no tapar la ruta. Si volví
// al punto de partida, las dos comparten una sola etiqueta.
const start = map.points[0];
const end = map.points.at(-1)!;
const backHome = !!last && Math.abs(start.x - end.x) < 2 && Math.abs(start.y - end.y) < 2;
const below = 'translate-y-2 -translate-x-3';
const labels: Label[] = !first
  ? []
  : backHome
    ? [
        {
          point: start,
          text: [last!.city, [year(first), lastWhen].filter(Boolean).join(' y ')].join(', '),
          class: below,
        },
      ]
    : [
        { point: start, text: [first.city, year(first)].filter(Boolean).join(', '), class: below },
        ...(last
          ? [
              {
                point: end,
                text: [last.city, lastWhen].filter(Boolean).join(', '),
                class: 'translate-x-2.5 -translate-y-1/2',
              },
            ]
          : []),
      ];

// La CSP no deja pasar atributos `style` sueltos: se autoriza cada posición por su hash
const positionOf = (point: Label['point']) => `left: ${point.x}%; top: ${point.y}%`;
if (labels.length) {
  Astro.csp?.insertStyleResource({ resource: "'unsafe-hashes'", kind: 'attribute' });
  for (const { point } of labels) {
    const hash = createHash('sha256').update(positionOf(point)).digest('base64');
    Astro.csp?.insertStyleHash({ hash: `sha256-${hash}`, kind: 'attribute' });
  }
}
---

<figure class="relative mx-auto max-w-[1100px] md:px-[22px]">
  <div class="relative">
    <svg viewBox={map.viewBox} role="img" aria-label={label} class="block h-auto w-full">
      <path d={map.land} class="fill-rule" />
      <path
        d={map.route}
        pathLength="1"
        class="route-line stroke-lamp fill-none"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d={map.dots}
        class="stroke-ink fill-none stroke-[3.5] sm:stroke-5"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
      />
    </svg>
    {labels.map(({ point, text, class: position }) => (
      <span
        aria-hidden="true"
        class:list={[
          'font-bodoni bg-paper/80 absolute px-1 text-[13px] whitespace-nowrap italic sm:text-[15px]',
          position,
        ]}
        style={positionOf(point)}
      >
        {text}
      </span>
    ))}
  </div>
</figure>

<style>
  /* El único momento de la página: la ruta se dibuja una vez, en el orden en que la hice */
  .route-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-line {
      animation: draw 4s cubic-bezier(0.45, 0, 0.25, 1) 0.3s both;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
