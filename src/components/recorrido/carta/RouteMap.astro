---
import { buildRouteMap } from '@/lib/route-map';
import type { RouteStop } from '@/lib/adapters/route-adapter';

interface Props {
  stops: RouteStop[];
  /** Para el lector de pantalla: qué muestra el mapa */
  label: string;
}

const { stops, label } = Astro.props;
const map = buildRouteMap(stops.map((stop) => stop.coordinates));

const first = stops[0];
const last = stops.at(-1);
const name = (stop: RouteStop) => [stop.city, stop.date?.slice(0, 4)].filter(Boolean).join(', ');

// La salida va debajo de su punto y la última parada a su derecha, para no tapar la ruta
const labels = [
  first && { point: map.points[0], text: name(first), class: 'translate-y-2 -translate-x-3' },
  last &&
    last !== first && {
      point: map.points.at(-1)!,
      text: name(last),
      class: 'translate-x-2.5 -translate-y-1/2',
    },
].filter(Boolean) as { point: { x: number; y: number }; text: string; class: string }[];
---

<figure class="relative mx-auto max-w-[1100px] md:px-[22px]">
  <div class="relative">
    <svg viewBox={map.viewBox} role="img" aria-label={label} class="block h-auto w-full">
      <path d={map.land} class="fill-rule" />
      <path
        d={map.route}
        pathLength="1"
        class="route-line stroke-lamp fill-none"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d={map.dots}
        class="stroke-ink fill-none stroke-[3.5] sm:stroke-5"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
      />
    </svg>
    {labels.map(({ point, text, class: position }) => (
      <span
        aria-hidden="true"
        class:list={[
          'font-bodoni bg-paper/80 absolute px-1 text-[13px] whitespace-nowrap italic sm:text-[15px]',
          position,
        ]}
        style={`left: ${point.x}%; top: ${point.y}%`}
      >
        {text}
      </span>
    ))}
  </div>
</figure>

<style>
  /* El único momento de la página: la ruta se dibuja una vez, en el orden en que la hice */
  .route-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-line {
      animation: draw 4s cubic-bezier(0.45, 0, 0.25, 1) 0.3s both;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
