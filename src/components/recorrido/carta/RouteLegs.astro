---
import Photo from '@/components/share/Photo.astro';
import { formatLongDate, formatMonthRange } from '@/lib/dates';
import type { RouteLeg } from '@/lib/adapters/route-adapter';

interface Props {
  legs: RouteLeg[];
}

const { legs } = Astro.props;

const count = (n: number) => (n === 1 ? '1 parada' : `${n} paradas`);
const when = (leg: RouteLeg) => (leg.from ? formatMonthRange(leg.from, leg.to) : null);
---

{legs.map((leg, index) => (
  <section
    id={`tramo-${index + 1}`}
    aria-labelledby={`tramo-${index + 1}-titulo`}
    class="mx-auto mt-[clamp(72px,12vh,128px)] grid max-w-[1100px] scroll-mt-8 gap-8 px-[22px] lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14"
  >
    <header class="lg:sticky lg:top-8 lg:self-start">
      <h2
        id={`tramo-${index + 1}-titulo`}
        class="font-bodoni text-[clamp(36px,5.4vw,60px)] leading-[1.02] font-semibold tracking-[-0.01em] text-balance"
      >
        {leg.country}
      </h2>
      <p class="text-muted mt-3 text-[17px]">
        {when(leg) && <>{when(leg)}, </>}
        {count(leg.stops.length)}
      </p>
    </header>

    <ol class="border-rule border-t">
      {leg.stops.map((stop) => (
        <li class="border-rule grid gap-5 border-b py-8 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-7">
          {stop.photo ? (
            <Photo
              src={stop.photo}
              alt={stop.city}
              width={1080}
              height={810}
              widths={[480, 720, 1080]}
              sizes="(min-width: 1144px) 270px, (min-width: 1024px) 24vw, (min-width: 640px) 38vw, 100vw"
              class="aspect-[3/2] w-full object-cover sm:aspect-[4/3]"
            />
          ) : (
            <span class="hidden sm:block" />
          )}
          <div>
            <h3 class="font-bodoni text-[clamp(24px,3vw,30px)] leading-[1.1] font-semibold text-balance">
              {stop.city}
            </h3>
            {stop.date && <p class="text-muted mt-1 text-[15px]">{formatLongDate(stop.date)}</p>}
            {stop.text && <p class="mt-4 text-[18px] leading-[1.6] text-pretty">{stop.text}</p>}
            {(stop.weeks.length > 0 || stop.mapsUrl) && (
              <p class="text-muted mt-4 text-[15px] leading-relaxed">
                {stop.weeks.length > 0 && (
                  <>
                    Lo cuento en{' '}
                    {stop.weeks.map((week, i) => (
                      <>
                        <a
                          href={week.href}
                          class="hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
                        >
                          {week.title}
                        </a>
                        {i < stop.weeks.length - 2
                          ? ', '
                          : i === stop.weeks.length - 2
                            ? ' y '
                            : ''}
                      </>
                    ))}
                    .{' '}
                  </>
                )}
                {stop.mapsUrl && (
                  <a
                    href={stop.mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
                  >
                    Ver en Google Maps
                  </a>
                )}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
))}
