---
import ProgressBar from '@/components/viaje/svelte/ProgressBar.svelte';
import MesCounter from '@/components/viaje/svelte/MesCounter.svelte';
import SemanaGrid from '@/components/viaje/svelte/SemanaGrid.svelte';
import type { Mes, Semana } from '@/lib/interfaces/viaje';

interface Props {
  months: Mes[];
}

const { months }: Props = Astro.props;
const totalWeeks = months.reduce((s: number, m: Mes) => s + m.semanas.length, 0);
---

<div class="pb-24">
  <section class="relative pt-28 pb-14 text-center">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-87.5 w-150 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(93,158,107,0.2)_0%,transparent_70%)] opacity-80"
    >
    </div>

    <div
      class="reveal border-green-main/40 bg-green-main/12 mx-auto mb-5 inline-flex items-center gap-2 rounded-full border px-4 py-1.5"
      style={'--delay: 0.2s'}
    >
      <div class="bg-green-main h-1.5 w-1.5 rounded-full"></div>
      <span class="font-dm text-green-soft text-[11px] tracking-[0.12em] uppercase">
        Feb 2024 — Feb 2025
      </span>
    </div>

    <h1 class="reveal heading-1" style={'--delay: 0.3s'}>
      Un año<br />viajando
    </h1>

    <ProgressBar {totalWeeks} client:load />
  </section>

  <div class="px-6 md:px-16">
    {
      months.map((mes: Mes) => (
        <div class="reveal mb-16" style={'--delay: 0.1s'}>
          <div class="mb-7 flex items-center gap-4">
            <div class="flex items-baseline gap-2.5">
              <h2 class="font-fraunces text-ash-text text-[28px] font-semibold italic">
                {mes.mes}
              </h2>
              <span class="font-dm text-ash-softest text-xs">{mes.year}</span>
            </div>
            <div class="h-px flex-1 bg-white/5" />
            <MesCounter
              weeks={mes.semanas.map((s: Semana) => s.slug)}
              weekNums={mes.semanas.map((s: Semana) => s.num)}
              client:visible
            />
          </div>
          <SemanaGrid semanas={mes.semanas} client:visible />
        </div>
      ))
    }
  </div>
</div>
