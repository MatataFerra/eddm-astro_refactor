---
import Video from '@/components/viaje/entry/Video.astro';

import 'photoswipe/style.css';
import MediaCard from '@/components/viaje/entry/MediaCard.astro';

interface MediaItem {
  type: 'image' | 'video';
  src: string;
  alt?: string;
  poster?: string;

  width?: number;
  height?: number;
}

interface Props {
  items: MediaItem[];
  caption?: string;
}

const { items, caption }: Props = Astro.props;
const count = items.length;

if (count === 0) return null;

// Layout logic
const isSingle = count === 1;
const isDouble = count === 2;
const isTriple = count === 3;
const isBento = count >= 4;
---

<div class="reveal pswp-gallery my-8">
  {/* LAYOUT 1: SINGLE */}
  {
    isSingle && (
      <div class="flex justify-center">
        <div
          class={
            items[0].type === 'video'
              ? 'aspect-video w-full'
              : 'max-w-(--breakpoint-sm) overflow-hidden rounded-xl border border-white/5'
          }
        >
          {items[0].type === 'video' ? (
            <Video item={items[0]} />
          ) : (
            <MediaCard
              item={items[0]}
              containerClass="max-w-(--breakpoint-sm) rounded-xl"
              imageClass="h-auto object-contain"
            />
          )}
        </div>
      </div>
    )
  }

  {/* LAYOUT 2: DOUBLE */}
  {
    isDouble && (
      <div class="grid grid-cols-2 gap-3">
        {items.map((item) => (
          <div class="aspect-4/5 overflow-hidden rounded-xl border border-white/5">
            {item.type === 'video' ? (
              <Video item={item} />
            ) : (
              <MediaCard item={item} containerClass="aspect-4/5 rounded-xl" imageClass="" />
            )}
          </div>
        ))}
      </div>
    )
  }

  {/* LAYOUT 3: TRIPLE */}
  {
    isTriple && (
      <div class="grid h-80 grid-cols-[1.2fr_1fr] grid-rows-2 gap-3 md:h-100">
        {items.map((item, idx) => (
          <div
            class={`${idx === 0 ? 'row-span-2' : ''} overflow-hidden rounded-xl border border-white/5`}
          >
            {item.type === 'video' ? (
              <Video item={item} />
            ) : (
              <MediaCard
                item={item}
                containerClass={`${idx === 0 ? 'row-span-2' : ''} rounded-xl`}
                imageClass=""
              />
            )}
          </div>
        ))}
      </div>
    )
  }

  {/* LAYOUT 4+: BENTO */}
  {
    isBento &&
      (() => {
        const hero = items[0];
        const rest = items.slice(1);

        const rows = [];
        let i = 0;

        while (i < rest.length) {
          const remaining = rest.length - i;

          // THIRD ITEM LARGE
          if (i === 2 && rest[i]) {
            rows.push({
              type: 'large',
              items: [rest[i]],
            });

            i += 1;
            continue;
          }

          // LAST ODD ITEM => LARGE
          if (remaining === 1) {
            rows.push({
              type: 'large',
              items: [rest[i]],
            });

            break;
          }

          // NORMAL DOUBLE ROW
          rows.push({
            type: 'double',
            items: [rest[i], rest[i + 1]],
          });

          i += 2;
        }

        return (
          <div class="space-y-3">
            {/* HERO */}
            {hero && (
              <MediaCard
                item={hero}
                containerClass="rounded-2xl"
                imageClass="h-[420px] md:h-[620px]"
              />
            )}

            {/* ROWS */}
            {rows.map((row) =>
              row.type === 'large' ? (
                <MediaCard
                  item={row.items[0]}
                  containerClass="rounded-2xl"
                  imageClass="h-[180px] md:h-[260px]"
                />
              ) : (
                <div class="grid grid-cols-2 gap-3">
                  {row.items.map((item) => (
                    <MediaCard
                      item={item}
                      containerClass="rounded-xl"
                      imageClass="aspect-square md:aspect-[4/3]"
                    />
                  ))}
                </div>
              )
            )}
          </div>
        );
      })()
  }

  {
    caption && (
      <p class="font-dm text-ash-softest mt-4 text-center text-[10px] tracking-widest uppercase">
        {caption}
      </p>
    )
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: 'a[data-pswp-width]',
    pswpModule: () => import('photoswipe'),
  });

  lightbox.init();
</script>
