---
import Video from '@/components/viaje/entry/Video.astro';
import { buildBentoRows } from '@/lib/bento';

import 'photoswipe/style.css';
import MediaCard from '@/components/viaje/entry/MediaCard.astro';
import { cn } from '@/lib/utils';
import type { MediaItem } from '@/lib/interfaces/media';

interface Props {
  items: MediaItem[];
  caption?: string;
}

const { items, caption }: Props = Astro.props;
const count = items.length;

if (count === 0) return null;

// Layout logic
const isSingle = count === 1;
const isDouble = count === 2;
const isTriple = count === 3;
const isBento = count >= 4;

const hero = items[0];
const rows = buildBentoRows(items.slice(1));
---

<div class="reveal pswp-gallery my-8">
  {/* LAYOUT 1: SINGLE */}
  {
    isSingle && (
      <div class="flex justify-center">
        <div
          class={
            items[0].type === 'video'
              ? 'aspect-video w-full'
              : 'max-w-(--breakpoint-sm) overflow-hidden rounded-xl border border-white/5'
          }
        >
          {items[0].type === 'video' ? (
            <Video item={items[0]} />
          ) : (
            <MediaCard
              item={items[0]}
              containerClass="max-w-(--breakpoint-sm) rounded-xl"
              mediaClass="h-auto object-contain"
            />
          )}
        </div>
      </div>
    )
  }

  {/* LAYOUT 2: DOUBLE */}
  {
    isDouble && (
      <div class="grid grid-cols-2 gap-3">
        {items.map((item) => (
          <div class="aspect-4/5 overflow-hidden rounded-xl border border-white/5">
            {item.type === 'video' ? (
              <Video item={item} />
            ) : (
              <MediaCard item={item} containerClass="aspect-4/5 rounded-xl" />
            )}
          </div>
        ))}
      </div>
    )
  }

  {/* LAYOUT 3: TRIPLE */}
  {
    isTriple && (
      <div class="grid h-80 grid-cols-[1.2fr_1fr] grid-rows-2 gap-3 md:h-100">
        {items.map((item, idx) => (
          <div
            class={`${idx === 0 ? 'row-span-2' : ''} overflow-hidden rounded-xl border border-white/5`}
          >
            {item.type === 'video' ? (
              <Video item={item} />
            ) : (
              <MediaCard
                item={item}
                containerClass={`${idx === 0 ? 'row-span-2' : ''} rounded-xl`}
              />
            )}
          </div>
        ))}
      </div>
    )
  }

  {/* LAYOUT 4+: BENTO */}
  {
    isBento && (
      <div class="space-y-3">
        {/* HERO */}
        {hero && (
          <div class="grid grid-cols-2 gap-3">
            <MediaCard
              item={hero}
              containerClass="overflow-hidden rounded-2xl border border-white/5 col-span-2"
              mediaClass="aspect-[16/10] w-full object-cover"
            />
          </div>
        )}

        {/* ROWS */}
        {rows.map((row) => {
          // -----------------------------------
          // DOUBLE
          // -----------------------------------

          if (row.type === 'double') {
            return (
              <div class="grid grid-cols-2 gap-3">
                {row.items.map((item) => (
                  <div class="aspect-square overflow-hidden rounded-xl border border-white/5">
                    <MediaCard
                      item={item}
                      containerClass="h-full w-full"
                      mediaClass="h-full w-full object-cover"
                    />
                  </div>
                ))}
              </div>
            );
          }

          // -----------------------------------
          // FEATURE
          // -----------------------------------

          if (row.type === 'feature') {
            const [large, smallA, smallB] = row.items;

            return (
              <div
                class={cn(
                  'grid gap-3 md:grid-cols-[1.4fr_1fr]',
                  row.reversed && 'md:grid-cols-[1fr_1.4fr]'
                )}
              >
                {/* LARGE */}
                <div class={cn(row.reversed && 'md:order-2')}>
                  <MediaCard
                    item={large}
                    containerClass="h-full overflow-hidden rounded-2xl border border-white/5"
                    mediaClass="h-full min-h-[420px] w-full object-cover"
                  />
                </div>

                {/* SMALL STACK */}
                <div class={cn('grid gap-3', row.reversed && 'md:order-1')}>
                  {[smallA, smallB].map((item) => (
                    <MediaCard
                      item={item}
                      containerClass="overflow-hidden rounded-xl border border-white/5"
                      mediaClass="aspect-[4/3] md:aspect-square object-cover"
                    />
                  ))}
                </div>
              </div>
            );
          }

          // -----------------------------------
          // FOOTER
          // -----------------------------------

          if (row.type === 'footer') {
            return (
              <div class="aspect-16/10 overflow-hidden rounded-2xl border border-white/5">
                <MediaCard
                  item={row.items[0]}
                  containerClass="h-full w-full"
                  mediaClass="h-full w-full object-cover"
                />
              </div>
            );
          }
        })}
      </div>
    )
  }

  {
    caption && (
      <p class="font-dm text-ash-softest mt-4 text-center text-[10px] tracking-widest uppercase">
        {caption}
      </p>
    )
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: 'a[data-pswp-width]',
    pswpModule: () => import('photoswipe'),
  });

  lightbox.init();
</script>
