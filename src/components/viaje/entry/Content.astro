---
import { processDiario } from '@/lib/markdown/process';
import MediaBlock from '@/components/viaje/entry/MediaBlock.astro';
import Article from '@/components/share/Article.astro';
import type { MediaItem } from '@/lib/interfaces/media';

interface Props {
  content: string;
}

const { content }: Props = Astro.props;

const DIAS = await processDiario(content);
---

<div class="mx-auto max-w-180 px-6 py-14">
  {
    DIAS?.map((dia) => {
      const isSingular = dia?.media?.length === 1;

      return (
        <div class="mb-20">
          <div class="reveal mb-8 flex items-center gap-4">
            <div class="bg-green-main h-2 w-2 rounded-full" />
            <h2 class="font-fraunces text-green-soft text-2xl font-semibold italic">{dia.title}</h2>
            <div class="h-px flex-1 bg-white/5" />
          </div>

          <Article htmlContent={dia.htmlContent} />

          {dia && dia?.media?.length && dia.media.length > 0 && (
            <div class="reveal mt-10">
              <MediaBlock
                items={dia.media as MediaItem[]}
                caption={`${dia?.media?.length} ${isSingular ? 'archivo' : 'archivos'} de ${dia?.title}`}
              />
            </div>
          )}
        </div>
      );
    })
  }
</div>
