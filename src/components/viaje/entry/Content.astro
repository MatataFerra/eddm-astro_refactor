---
import { processDiario } from '@/lib/markdown/parse';
import MediaBlock from '@/components/viaje/entry/MediaBlock.astro';

interface Props {
  content: string;
}

const { content }: Props = Astro.props;

const DIAS = processDiario(content);
---

<div class="mx-auto max-w-180 px-6 py-14">
  {
    DIAS?.map((dia) => {
      const isSingular = dia.media.length === 1;

      return (
        <div class="mb-20">
          <div class="reveal mb-8 flex items-center gap-4">
            <div class="h-2 w-2 rounded-full bg-[#5d9e6b]" />
            <h2 class="font-fraunces text-2xl font-semibold text-[#8ac49a] italic">{dia.title}</h2>
            <div class="h-px flex-1 bg-white/5" />
          </div>

          <div
            class="reveal prose prose-invert font-dm prose-p:mb-6 prose-strong:text-[#8ac49a] prose-a:text-[#8ac49a] prose-a:no-underline hover:prose-a:underline max-w-none text-[17px] leading-[1.9] font-light text-[#bbb]"
            set:html={dia.htmlContent}
          />

          {dia.media.length > 0 && (
            <div class="reveal mt-10">
              <MediaBlock
                items={dia.media}
                caption={`${dia.media.length} ${isSingular ? 'archivo' : 'archivos'} de ${dia.title}`}
              />
            </div>
          )}
        </div>
      );
    })
  }
</div>
