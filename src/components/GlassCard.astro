---
interface Props {
  title: string;
  tag?: string;
  summary?: string;
  imgSrc: string;
  href?: string;
  delay?: number;
}

const { title, tag, summary, imgSrc, href = '#', delay = 0 } = Astro.props;
---

<div class="reveal h-full" style={`--delay: ${delay}s`}>
  <a {href} class="group block h-full no-underline">
    <div
      class="group-hover:border-accent-main/50 relative h-full min-h-80 overflow-hidden rounded-[20px] border border-white/5 shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[0_24px_60px_rgba(0,0,0,0.5),0_0_0_1px_var(--color-accent-main)]"
    >
      <div class="absolute inset-0">
        <img
          src={imgSrc}
          alt={title}
          class="block h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
        <div class="from-ash-main via-ash-main/50 absolute inset-0 bg-linear-to-t to-transparent">
        </div>
      </div>

      <div
        class="absolute right-0 bottom-0 left-0 border-t border-white/5 bg-[#08080e]/60 p-6 backdrop-blur-md"
      >
        {
          tag && (
            <div class="mb-2 flex items-center gap-2">
              <span class="text-accent-text font-dm bg-accent-soft border-accent-main/30 rounded-full border px-2 py-0.75 text-[9px] tracking-[0.14em] uppercase">
                {tag}
              </span>
            </div>
          )
        }

        <div
          class={`font-fraunces text-[21px] leading-tight font-semibold tracking-tight text-ash-text ${summary ? 'line-clamp-2' : 'line-clamp-none'}`}
        >
          {title}
        </div>

        {
          summary && (
            <p class="font-dm text-ash-hard mt-2 line-clamp-2 text-xs leading-relaxed font-light">
              {summary}
            </p>
          )
        }

        <div class="text-accent-text font-dm mt-3 flex items-center gap-1.5 text-xs">
          <span>Leer</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1"> → </span>
        </div>
      </div>
    </div>
  </a>
</div>
