---
// El día entero en una línea: de 00:00 a la izquierda a 24:00 a la derecha, con el color del
// cielo de cada hora. Lo vivido va a color pleno y lo que falta, apagado. Al abrir la página
// pasa una sola cosa: una aurora vibra sobre la línea, sale el sol (o la luna, de noche) hasta
// su lugar en el arco, y la aurora se calma hasta dejar los colores quietos.
import { DAWN_START, DAY_START, DUSK_START, NIGHT_START } from '@/lib/day-phases';

const at = (hour: number) => `${(hour / 24) * 100}%`;
// Las paradas del color salen de los mismos cortes que las luces de la página
const sky = [
  `var(--color-sky-night) 0%`,
  `var(--color-sky-night) ${at(DAWN_START - 0.5)}`,
  `var(--color-sky-dawn) ${at(DAWN_START + 1)}`,
  `var(--color-sky-gold) ${at(DAY_START - 0.75)}`,
  `var(--color-sky-day) ${at(DAY_START + 1)}`,
  `var(--color-sky-day) ${at(DUSK_START - 1)}`,
  `var(--color-sky-gold) ${at(DUSK_START)}`,
  `var(--color-sky-dusk) ${at(DUSK_START + 1.5)}`,
  `var(--color-sky-blue-hour) ${at(NIGHT_START)}`,
  `var(--color-sky-night) ${at(NIGHT_START + 1.5)}`,
  `var(--color-sky-night) 100%`,
].join(', ');

// Rayos irregulares: largos y ángulos fijos (no aleatorios) para que el sol sea siempre el mismo
const RAYS = [
  [0, 7.5],
  [27, 4.5],
  [52, 6.5],
  [80, 3.8],
  [101, 7],
  [128, 4.8],
  [151, 6],
  [178, 4],
  [203, 7.2],
  [231, 4.2],
  [254, 5.8],
  [283, 3.6],
  [306, 6.8],
  [334, 4.6],
];
const rays = RAYS.map(([deg, length]) => {
  const rad = ((deg - 90) * Math.PI) / 180;
  const from = 8.6;
  const to = from + length;
  const point = (r: number) =>
    `${(20 + Math.cos(rad) * r).toFixed(2)} ${(20 + Math.sin(rad) * r).toFixed(2)}`;
  return `M${point(from)}L${point(to)}`;
}).join('');
---

<div
  class="horizon mx-auto mt-8 max-w-[700px] px-[22px]"
  aria-hidden="true"
  data-horizon
  style={`--sky: linear-gradient(to right, ${sky}); --dawn-x: ${at((DAWN_START + DAY_START) / 2)}; --dusk-x: ${at((DUSK_START + NIGHT_START) / 2)};`}
>
  <div class="sky-frame">
    <span class="aurora aurora-1"></span>
    <span class="aurora aurora-2"></span>
    <span class="aurora aurora-3"></span>

    <span class="glow glow-dawn"></span>
    <span class="glow glow-dusk"></span>

    <svg class="body sun" viewBox="0 0 40 40">
      <path d={rays} stroke="var(--color-sun)" stroke-width="1.3" stroke-linecap="round"></path>
      <circle
        cx="20"
        cy="20"
        r="6.2"
        fill="var(--color-sun-core)"
        stroke="var(--color-sun)"
        stroke-width="1"
      ></circle>
    </svg>
    <svg class="body moon" viewBox="0 0 40 40" fill="currentColor">
      <path d="M23.5 11.5a8.5 8.5 0 1 0 5 15.4 9.5 9.5 0 0 1-5-15.4Z"></path>
    </svg>
  </div>

  <div class="line">
    <span class="line-future"></span>
    <span class="line-lived"></span>
  </div>
</div>

<style>
  .horizon {
    --x: 0%;
    --sun-y: 40px;
    --moon-y: 40px;
    --saturation: 1;
    /* Sobre papel claro la aurora pesa más: va más tenue que de noche */
    --aurora-peak: 0.5;
  }

  :global(:root[data-phase='dusk']) .horizon,
  :global(:root[data-phase='night']) .horizon {
    --aurora-peak: 0.75;
  }

  /* Todo lo que está sobre la línea; lo que baja de ella se esconde */
  .sky-frame {
    position: relative;
    height: 52px;
    overflow: hidden;
  }

  .line {
    position: relative;
    height: 2px;
    filter: saturate(var(--saturation));
    transition: filter 1600ms ease;
  }

  .line > span {
    position: absolute;
    inset: 0;
    background: var(--sky);
  }

  .line-future {
    opacity: 0.28;
  }

  .line-lived {
    clip-path: inset(0 calc(100% - var(--x)) 0 0);
  }

  /* La aurora: bandas de luz que vibran mientras llega el sol y después se apagan */
  .aurora {
    position: absolute;
    bottom: -14px;
    height: 46px;
    border-radius: 50%;
    filter: blur(12px);
    opacity: 0;
    pointer-events: none;
  }

  .aurora-1 {
    left: 4%;
    width: 46%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-sky-aurora),
      var(--color-sky-blue-hour),
      transparent
    );
  }

  .aurora-2 {
    left: 30%;
    width: 42%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-sky-dawn),
      var(--color-sky-gold),
      transparent
    );
  }

  .aurora-3 {
    left: 52%;
    width: 44%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-sky-blue-hour),
      var(--color-sky-aurora),
      transparent
    );
  }

  .is-arriving .aurora {
    animation:
      aurora-shimmer 900ms ease-in-out infinite alternate,
      aurora-life 3400ms ease forwards;
  }

  .is-arriving .aurora-2 {
    animation-duration: 700ms, 3400ms;
    animation-delay: -250ms, 0ms;
  }

  .is-arriving .aurora-3 {
    animation-duration: 1100ms, 3400ms;
    animation-delay: -500ms, 0ms;
  }

  @keyframes aurora-shimmer {
    from {
      transform: translateX(-6%) scaleY(0.7) skewX(-8deg);
    }
    to {
      transform: translateX(6%) scaleY(1.15) skewX(8deg);
    }
  }

  @keyframes aurora-life {
    0% {
      opacity: 0;
    }
    18%,
    55% {
      opacity: var(--aurora-peak);
    }
    100% {
      opacity: 0;
    }
  }

  /* La luz del amanecer y del atardecer, apoyada sobre la línea */
  .glow {
    position: absolute;
    bottom: -18px;
    width: 34%;
    height: 44px;
    translate: -50% 0;
    border-radius: 50%;
    filter: blur(14px);
    opacity: 0.14;
    transition: opacity 2400ms ease;
  }

  .glow-dawn {
    left: var(--dawn-x);
    background: radial-gradient(
      closest-side,
      var(--color-sky-dawn),
      color-mix(in oklab, var(--color-sky-gold) 55%, transparent),
      transparent
    );
  }

  .glow-dusk {
    left: var(--dusk-x);
    background: radial-gradient(
      closest-side,
      var(--color-sky-dusk),
      color-mix(in oklab, var(--color-sky-gold) 55%, transparent),
      transparent
    );
  }

  :global(:root[data-hour-phase='dawn']) .glow-dawn,
  :global(:root[data-hour-phase='dusk']) .glow-dusk {
    opacity: 0.6;
  }

  .body {
    position: absolute;
    bottom: 0;
    left: var(--x);
    width: 34px;
    height: 34px;
    color: var(--color-ink);
    translate: -50% 50%;
    transition: transform 1500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sun {
    transform: translateY(var(--sun-y));
  }

  .moon {
    transform: translateY(var(--moon-y));
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .glow,
    .body {
      transition: none;
    }

    .is-arriving .aurora {
      animation: none;
    }
  }
</style>

<script>
  import { DAWN_START, NIGHT_START, hourIn } from '@/lib/day-phases';

  const horizon = document.querySelector<HTMLElement>('[data-horizon]');
  const timeZone = document.documentElement.dataset.tz;
  const SUN_ARC = 28;
  const MOON_ARC = 16;
  const HIDDEN = 40;
  const DAY_LENGTH = NIGHT_START - DAWN_START;
  const NIGHT_LENGTH = 24 - DAY_LENGTH;

  // Cuánto subió el sol o la luna: 0 sobre la línea al salir y al ponerse, máximo a mitad de camino
  function heights(hour: number) {
    const sunT = (hour - DAWN_START) / DAY_LENGTH;
    const moonT = ((((hour - NIGHT_START) % 24) + 24) % 24) / NIGHT_LENGTH;
    const isDay = sunT >= 0 && sunT <= 1;
    return {
      sun: isDay ? -Math.sin(Math.PI * sunT) * SUN_ARC : HIDDEN,
      moon: isDay ? HIDDEN : -Math.sin(Math.PI * Math.min(moonT, 1)) * MOON_ARC,
    };
  }

  function place(hour: number) {
    if (!horizon) return;
    const { sun, moon } = heights(hour);
    horizon.style.setProperty('--x', `${(hour / 24) * 100}%`);
    horizon.style.setProperty('--sun-y', `${sun}px`);
    horizon.style.setProperty('--moon-y', `${moon}px`);
  }

  if (horizon && timeZone) {
    const now = hourIn(timeZone);

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      place(now);
    } else {
      // La llegada, una sola vez: aurora y día que se pinta, sale el sol, todo se calma
      horizon.classList.add('is-arriving');
      horizon.style.setProperty('--saturation', '1.8');
      horizon.style.setProperty('--x', `${(now / 24) * 100}%`);

      const start = performance.now();
      const draw = (time: number) => {
        const t = Math.min(1, (time - start) / 1600);
        horizon.style.setProperty('--x', `${((now * (1 - Math.pow(1 - t, 3))) / 24) * 100}%`);
        if (t < 1) requestAnimationFrame(draw);
      };
      requestAnimationFrame(draw);

      setTimeout(() => place(now), 1100);
      setTimeout(() => horizon.style.setProperty('--saturation', '1'), 2000);
      setTimeout(() => horizon.classList.remove('is-arriving'), 3500);
    }

    setInterval(() => place(hourIn(timeZone)), 30_000);
  }
</script>
