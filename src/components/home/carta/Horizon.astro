---
// Un horizonte con el sol o la luna de la hora de allá. Lo mueve sólo el CSS según
// data-hour-phase, que el script del <head> actualiza cada cinco minutos.
---

<div class="horizon relative mx-auto mt-8 h-8 max-w-[700px] px-[22px]" aria-hidden="true">
  <span class="bg-rule absolute inset-x-[22px] bottom-0 h-px"></span>
  <div class="absolute bottom-px left-1/2 h-8 w-14 -translate-x-1/2 overflow-hidden">
    <svg class="sky sun" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.25">
      <circle cx="14" cy="14" r="5.5"></circle>
      <path
        d="M14 2.5v3M14 22.5v3M2.5 14h3M22.5 14h3M5.9 5.9l2.1 2.1M20 20l2.1 2.1M5.9 22.1L8 20M20 8l2.1-2.1"
        stroke-linecap="round"
      ></path>
    </svg>
    <svg class="sky moon" viewBox="0 0 28 28" fill="currentColor">
      <path d="M17.5 5.5a8.5 8.5 0 1 0 5 15.4A9.5 9.5 0 0 1 17.5 5.5Z"></path>
    </svg>
  </div>
</div>

<style>
  .sky {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 28px;
    height: 28px;
    color: var(--color-ink);
    translate: -50% 0;
    transition:
      transform 1200ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 1200ms ease;
  }

  /* Día: el sol apoyado sobre la línea. Amanecer y atardecer: a medias. Noche: la luna. */
  .sun {
    transform: translateY(0);
  }
  .moon {
    transform: translateY(110%);
    opacity: 0;
  }

  :global(:root[data-hour-phase='dawn']) .sun,
  :global(:root[data-hour-phase='dusk']) .sun {
    transform: translateY(50%);
  }

  :global(:root[data-hour-phase='night']) .sun {
    transform: translateY(110%);
    opacity: 0;
  }

  :global(:root[data-hour-phase='night']) .moon {
    transform: translateY(0);
    opacity: 1;
  }

  /* Primero se pone uno y después sale el otro: el que entra espera al que se va */
  .sun,
  :global(:root[data-hour-phase='night']) .moon {
    transition-delay: 700ms;
  }

  :global(:root[data-hour-phase='night']) .sun {
    transition-delay: 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .sky {
      transition: none;
    }
  }
</style>
