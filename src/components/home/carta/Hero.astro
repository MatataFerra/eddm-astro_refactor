---
import Dateline from '@/components/share/carta/Dateline.astro';
import Photo from '@/components/share/Photo.astro';
import Horizon from '@/components/home/carta/Horizon.astro';

interface Props {
  place: string | null;
  timeZone?: string;
  photo: string | null;
}

const { place, timeZone, photo } = Astro.props;
---

<section aria-label="Desde dónde escribo">
  <div class="mx-auto max-w-[700px] px-[22px] pt-[clamp(40px,9vh,96px)]">
    <Dateline as="h1" size="lg" place={place ?? undefined} date={new Date()} {timeZone} />
    <!-- Ocupa su lugar desde el HTML: mientras llega la hora, un bloque de carga en vez de un salto -->
    {timeZone && (
      <p class="text-muted mt-3.5 text-right text-base" data-clock aria-busy="true">
        Acá son las{' '}
        <span class="text-lamp tabular-nums" data-clock-time>
          <span class="clock-loading w-[5ch]" />
        </span>
        <span data-clock-phase>
          {' '}
          <span class="clock-loading w-[11ch]" />
        </span>
        .
      </p>
    )}
  </div>

  {timeZone && <Horizon />}

  {photo && (
    <div class="mx-auto mt-8 max-w-[1100px] md:mt-10 md:px-[22px]">
      <Photo
        src={photo}
        alt={place ? `${place}, hoy` : 'El lugar desde donde escribo'}
        width={1920}
        height={1280}
        sizes="(min-width: 1144px) 1100px, 100vw"
        priority
        class="aspect-[4/3] w-full object-cover md:aspect-[16/9]"
      />
    </div>
  )}
</section>

<style>
  .clock-loading {
    display: inline-block;
    height: 0.9em;
    vertical-align: -0.1em;
    border-radius: 2px;
    background: var(--color-rule);
  }

  @media (prefers-reduced-motion: no-preference) {
    .clock-loading {
      animation: clock-pulse 1.4s ease-in-out infinite;
    }
  }

  @keyframes clock-pulse {
    50% {
      opacity: 0.45;
    }
  }

  /* Sin JS no hay hora que esperar */
  :global(:root:not([data-phase])) [data-clock] {
    display: none;
  }
</style>

<script>
  import { SKY_EVENT, formatHour, hourNow } from '@/lib/day-phases';

  // La página es estática: la fecha y la hora de allá se actualizan acá.
  const root = document.documentElement;
  const timeZone = root.dataset.tz;
  const PHASE_WORDS: Record<string, string> = {
    night: 'es de noche',
    dawn: 'está amaneciendo',
    day: 'es de día',
    dusk: 'está atardeciendo',
  };

  function tick() {
    if (!timeZone) return;
    const now = new Date();
    const date = new Intl.DateTimeFormat('es-AR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone,
    }).format(now);
    const time = formatHour(hourNow(timeZone));

    document.querySelectorAll('[data-dateline-date]').forEach((el) => {
      if (el.closest('h1')) el.textContent = date;
    });
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (!clock) return;
    clock.querySelector('[data-clock-time]')!.textContent = time;
    clock.querySelector('[data-clock-phase]')!.textContent =
      ` y ${PHASE_WORDS[root.dataset.hourPhase ?? 'day'] ?? ''}`;
    clock.removeAttribute('aria-busy');
  }

  tick();
  setInterval(tick, 30_000);
  document.addEventListener(SKY_EVENT, tick);
</script>
