---
import HeroImage from '@/components/HeroImage.astro';
import HeroTitle from '@/components/HeroTitle.astro';
---

<section class="relative flex min-h-screen items-center overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_50%,rgba(212,168,67,0.12)_0%,transparent_60%)]"
  >
  </div>
  <div class="from-ash-main absolute right-0 bottom-0 left-0 h-75 bg-linear-to-t to-transparent">
  </div>

  <div
    class="relative z-10 mx-auto grid w-full max-w-350 items-center gap-20 px-10 pt-15 pb-10 md:px-20 md:pt-30 md:pb-20 lg:grid-cols-2"
  >
    <HeroTitle />
    <HeroImage />
  </div>

  <div class="absolute bottom-9 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2">
    <div class="to-accent-main h-12 w-px bg-linear-to-b from-transparent"></div>
    <div class="bg-accent-main h-1.5 w-1.5 animate-pulse rounded-full"></div>
  </div>
</section>
