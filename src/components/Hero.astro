---
import LatestEntry, { type Latest } from '@/components/home/LatestEntry.astro';
import TripRuler from '@/components/home/TripRuler.astro';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import { getAllStats } from '@/lib/api/get-stats';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import { adaptArticlesToMeses } from '@/lib/adapters/viaje-adapter';
import type { ContentNavigate } from '@/lib/interfaces/share';
import type { Stats } from '@/lib/interfaces/stats';
import type { Location } from '@/lib/interfaces/location';

interface Props {
  latest: Latest | null;
}

const { latest }: Props = Astro.props;

const [articles, stats, location] = await Promise.all([
  getContentNavigate<ContentNavigate[]>('articles'),
  getAllStats<Stats>(),
  getCurrentLocation<Location>(),
]);

const months = adaptArticlesToMeses(articles?.data ?? []);

const number = new Intl.NumberFormat('es-AR');
const s = stats?.data;
const tally = s
  ? `${number.format(s.notes)} notas, ${number.format(s.countries)} países, ${number.format(s.km)} km y ${number.format(s.days)} días de camino.`
  : null;

const here = location?.data;
---

<section class="mx-auto max-w-350 px-6 pt-28 pb-4 md:px-20 md:pt-36">
  <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-x-20 lg:gap-y-14">
    <div>
      <h1 class="reveal font-fraunces text-ash-text text-[clamp(56px,7.2vw,120px)] leading-[0.9] font-extrabold tracking-[-0.04em] text-balance">
        El diario de Mati
      </h1>
      <p
        class="reveal font-fraunces text-ash-text/90 mt-8 max-w-[30ch] text-[clamp(22px,2.3vw,32px)] leading-[1.35] font-light italic md:mt-10"
        style="--delay: 0.1s"
      >
        Escribo desde que tengo memoria. La escritura no me ha abandonado, sea por desahogo o para
        ordenar pensamientos.
      </p>
    </div>

    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-end">
      <LatestEntry {latest} />
    </div>

    {(here || tally) && (
      <aside class="reveal border-accent-main/40 max-w-[44ch] border-l pl-6" style="--delay: 0.25s">
        {here && (
          <Fragment>
            <p class="font-fraunces text-ash-text text-[clamp(20px,1.8vw,24px)] leading-tight italic">
              Hoy escribo desde <span class="text-accent-text not-italic">{here.name}</span>
              {here.metadata?.emoji && <span aria-hidden="true">{here.metadata.emoji}</span>}
            </p>
            {here.metadata?.description && (
              <p class="font-dm text-ash-hard mt-3 text-sm leading-relaxed font-light">
                {here.metadata.description}
              </p>
            )}
          </Fragment>
        )}
        {tally && (
          <p class="font-dm text-ash-soft mt-4 text-sm leading-relaxed">Hasta ahora: {tally}</p>
        )}
      </aside>
    )}
  </div>

  <TripRuler {months} />
</section>
