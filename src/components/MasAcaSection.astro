---
import MasAcaCard from '@/components/MasAcaCard.astro';
import { getContentNavigateFurtherTimeArticles } from '@/lib/api/get-content-navigate';
import { APP_ROUTER } from '@/lib/constants';
import type { ContentNavigate } from '@/lib/interfaces/share';

const maaca = await getContentNavigateFurtherTimeArticles<ContentNavigate[]>();
---

<section>
  <div class="reveal">
    <div class="mb-9 flex items-baseline gap-4">
      <div class="flex items-center gap-2.5">
        <h2
          class="font-fraunces text-ash-text text-[30px] font-semibold tracking-[-0.02em] not-italic"
        >
          Más acá en el tiempo
        </h2>
      </div>
      <div class="h-px flex-1 bg-white/5"></div>
      <a
        href={APP_ROUTER.FURTHER_TIME}
        class="font-dm text-blue-soft text-xs tracking-[0.06em] whitespace-nowrap no-underline"
      >
        Ver todas →
      </a>
    </div>
    <p class="font-dm text-ash-soft mb-7 text-[14px] font-light tracking-[0.01em]">
      Historias que pasaron recientemente y que quizás no sean correlativas.
    </p>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {maaca?.data.map((item, i) => <MasAcaCard item={item} delay={i * 0.1} />)}
  </div>
</section>
