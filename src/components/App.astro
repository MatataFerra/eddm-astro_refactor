---
import StatsBar from '@/components/StatsBar.astro';
import MasAcaSection from '@/components/MasAcaSection.astro';
import JapanTeaser from '@/components/JapanTeaser.astro';
import Relatos from '@/components/Relatos.astro';
import Hero from '@/components/Hero.astro';
---

<div>
  <Hero />

  <section class="p-10 md:px-20 md:pb-20">
    <StatsBar />
  </section>

  <section class="p-10 md:px-20 md:pb-20">
    <div class="reveal mb-12 flex items-baseline gap-4">
      <h2 class="font-fraunces text-4xl font-semibold tracking-[-0.02em] text-[#f0eeff]">
        Relatos y escritos
      </h2>
      <div class="h-px flex-1 bg-white/10"></div>
      <a
        href="/relatos"
        class="font-dm text-accent-text text-xs tracking-[0.06em] whitespace-nowrap no-underline"
        >Ver todos →</a
      >
    </div>

    <Relatos />
  </section>

  <section class="p-10 md:px-20 md:pb-20">
    <MasAcaSection />
  </section>

  <section class="p-10 md:px-20 md:pb-30">
    <JapanTeaser />
  </section>
</div>
