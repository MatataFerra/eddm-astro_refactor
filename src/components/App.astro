---
import Hero from '@/components/Hero.astro';
import type { Latest, LatestKind } from '@/components/home/LatestEntry.astro';
import IndexSection, { type IndexItem } from '@/components/home/IndexSection.astro';
import IndexPoem from '@/components/home/IndexPoem.astro';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import { APP_ROUTER } from '@/lib/constants';
import { toPoema } from '@/lib/poems';
import type { ContentNavigate } from '@/lib/interfaces/share';

const ITEMS_PER_SECTION = 4;

const [tales, poems, further] = await Promise.all([
  getContentNavigate<ContentNavigate[]>('tales'),
  getContentNavigate<ContentNavigate[]>('poems'),
  getContentNavigate<ContentNavigate[]>('further'),
]);

const toItems = (entries: ContentNavigate[], href: (slug: string) => string): IndexItem[] =>
  entries.slice(0, ITEMS_PER_SECTION).map((entry) => ({
    href: href(entry.slug),
    title: entry.title,
    summary: entry.summary,
    image: entry.header?.url,
  }));

const talesData = tales?.data ?? [];
const furtherData = further?.data ?? [];
const poemsData = poems?.data ?? [];
const latestPoem = poemsData[0] ? toPoema(poemsData[0], poemsData[0].description) : null;

// Lo último que escribí, sea relato, poema o historia: el hero lo ofrece como primera lectura
const toLatest = (
  entries: ContentNavigate[],
  kind: LatestKind,
  href: (slug: string) => string
): Latest[] =>
  entries.map((entry) => ({
    kind,
    href: href(entry.slug),
    title: entry.title,
    excerpt: entry.summary?.trim() ?? '',
    createdAt: entry.createdAt ? new Date(entry.createdAt).toISOString() : '',
    place: kind === 'poema' ? entry.description : null,
  }));

const latest =
  [
    ...toLatest(talesData, 'relato', APP_ROUTER.TALE),
    ...toLatest(poemsData, 'poema', APP_ROUTER.POEM),
    ...toLatest(furtherData, 'historia', APP_ROUTER.FURTHER_TIME_ARTICLE),
  ]
    .filter((entry) => entry.createdAt)
    .sort((a, b) => b.createdAt.localeCompare(a.createdAt))[0] ?? null;
---

<main>
  <Hero {latest} />

  <div class="mx-auto max-w-350 px-6 pt-8 pb-16 md:px-20 md:pb-24">
    {talesData.length > 0 && (
      <IndexSection
        title="Relatos"
        href={APP_ROUTER.TALES}
        blurb="Historias que nacieron en cuadernos, servilletas y apps de notas alrededor del mundo."
        countLabel={`${talesData.length} relatos`}
        linkLabel={`Ver los ${talesData.length} relatos`}
        tone="accent"
        items={toItems(talesData, APP_ROUTER.TALE)}
      />
    )}

    {latestPoem && <IndexPoem poema={latestPoem} total={poemsData.length} />}

    {furtherData.length > 0 && (
      <IndexSection
        title="Más acá en el tiempo"
        href={APP_ROUTER.FURTHER_TIME}
        blurb="Historias que pasaron recientemente y que quizás no sean correlativas."
        countLabel={`${furtherData.length} historias`}
        linkLabel={`Ver las ${furtherData.length} historias`}
        tone="blue"
        items={toItems(furtherData, APP_ROUTER.FURTHER_TIME_ARTICLE)}
      />
    )}
  </div>
</main>
