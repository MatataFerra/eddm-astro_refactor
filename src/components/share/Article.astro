---
import type { RelatoType } from '@/lib/markdown/process';

interface Props {
  htmlContent: string | Promise<string>;
  variant?: RelatoType;
}

const { htmlContent, variant = 'prose' }: Props = Astro.props;
---

<article
  class:list={[
    'prose prose-invert prose-p:font-serif prose-p:font-normal prose-p:text-xl prose-p:text-ash-text/90 prose-strong:text-accent-text',
    variant === 'poem'
      ? 'poem prose-p:leading-relaxed prose-p:mb-10'
      : 'prose-p:leading-loose prose-p:mb-6',
  ]}
  set:html={htmlContent}
/>
