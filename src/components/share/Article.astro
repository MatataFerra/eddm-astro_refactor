---
interface Props {
  htmlContent: string | Promise<string>;
}

const { htmlContent }: Props = Astro.props;
---

<article
  class="prose prose-invert prose-p:font-serif prose-p:font-normal prose-p:text-xl prose-p:leading-loose prose-p:text-ash-text/90 prose-p:mb-6 prose-strong:text-accent-text"
  set:html={htmlContent}
/>
