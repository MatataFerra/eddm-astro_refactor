---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="bg-striped flex size-full items-center justify-center border border-white/5 p-3">
  <span
    class="text-muted text-center font-mono text-[11px] leading-relaxed tracking-wider uppercase"
  >
    {label}
  </span>
</div>

<style>
  .bg-striped {
    background-image: linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.05) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.05) 75%,
      transparent 75%,
      transparent
    );
    background-size: 20px 20px;
  }
</style>
