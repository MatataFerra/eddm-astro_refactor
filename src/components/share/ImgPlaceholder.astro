---
import ImageSlider from '@/components/share/svelte/ImageSlider.svelte';
import { getTrip } from '@/lib/api/get-trip';
import type { Trip } from '@/lib/interfaces/recorrido';

const trip = await getTrip<Trip>();

type ImageSlider = {
  url: string;
  id: string;
  city: string;
}[];

const PLACEHOLDER =
  'https://res.cloudinary.com/docq8rbdu/image/upload/v1777827696/el-diario-de-mati/trips/Whitehaven_Beach_tr341v.webp';

let getStopImages: ImageSlider = [
  {
    url: PLACEHOLDER,
    id: 'placeholder-1',
    city: 'Whitheaven Beach',
  },
];

if (trip?.data) {
  getStopImages = trip.data.stops.map((stop) => ({
    url: stop.stopImage || PLACEHOLDER,
    id: stop.id,
    city: stop.city,
  }));
}
---

<div class="flex size-full items-center justify-center border border-white/5 p-3">
  <ImageSlider client:load locations={getStopImages} />
</div>
