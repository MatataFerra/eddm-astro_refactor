---
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'main' | 'detail';
  color?: 'green' | 'blue' | 'accent';
  title?: string;
  links?: LinkKey[];
}

const topLevelRoutes = ['/viaje', '/relatos', '/mas-aca-en-el-tiempo'];

const {
  variant = 'main',
  color = 'green',
  title = 'Un año viajando',
  links = topLevelRoutes.map((path) => path.replace('/', '')) as LinkKey[],
} = Astro.props;

const LINK_MAP = {
  viaje: { name: 'Un año viajando', color: 'green' },
  relatos: { name: 'Relatos', color: 'accent' },
  'mas-aca-en-el-tiempo': { name: 'Más acá en el tiempo', color: 'blue' },
} as const;

type LinkKey = keyof typeof LINK_MAP;

const isMain = variant === 'main';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<nav
  data-navbar
  class="fixed top-0 right-0 left-0 z-1000 flex h-15 items-center justify-between border-b border-transparent bg-transparent px-6 transition-all duration-400 ease-in-out md:px-10"
>
  {
    isMain ? (
      <span class="font-fraunces text-ash-text z-50 text-lg font-semibold tracking-tight italic">
        el diario de mati
      </span>
    ) : (
      <div class="z-50 flex items-center gap-4">
        <a
          href="/"
          class="font-fraunces text-ash-text text-[17px] italic no-underline transition-opacity hover:opacity-70"
        >
          el diario de mati
        </a>
      </div>
    )
  }

  {
    isMain ? (
      <>
        <div class="hidden items-center gap-8 md:flex">
          {links.map((link) => (
            <a
              href={`/${link}`}
              class="font-dm hover:text-accent-text text-xs tracking-widest text-[#888] uppercase no-underline transition-colors duration-200"
            >
              {LINK_MAP[link]?.name || link}
            </a>
          ))}
          <span class="border-accent-main text-accent-text font-dm bg-accent-soft hover:bg-accent-glow cursor-pointer rounded-full border px-4 py-1.5 text-[11px] tracking-widest uppercase transition-colors">
            Japón →
          </span>
        </div>

        <button
          id="menu-btn"
          class="z-50 flex cursor-pointer flex-col gap-1.5 md:hidden"
          aria-label="Menu"
          aria-expanded="false"
        >
          <div class="line-1 bg-ash-text h-0.5 w-6 origin-center transition-all duration-300" />
          <div class="line-2 bg-ash-text h-0.5 w-6 transition-all duration-300" />
          <div class="line-3 bg-ash-text h-0.5 w-6 origin-center transition-all duration-300" />
        </button>

        <div
          id="mobile-menu"
          class="mobile-menu bg-ash-main/98 fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 backdrop-blur-xl transition-all duration-500 ease-in-out md:hidden"
        >
          {links.map((link) => (
            <a
              href={`/${link}`}
              class="font-fraunces hover:text-accent-text text-ash-text text-4xl italic no-underline transition-colors"
            >
              {LINK_MAP[link]?.name || link}
            </a>
          ))}
          <span class="border-accent-main text-accent-text font-dm bg-accent-soft mt-4 rounded-full border px-8 py-3 text-sm tracking-widest uppercase transition-colors">
            Japón →
          </span>
        </div>
      </>
    ) : (
      <a
        href={`/${currentPath.split('/')[1]}`}
        class={cn(
          'font-dm text-sm font-medium tracking-[0.12em] uppercase',
          color ? `text-${color}-main` : 'text-ash-text'
        )}
      >
        {title}
      </a>
    )
  }
</nav>

<style>
  .mobile-menu {
    visibility: hidden;
    opacity: 0;
    transform: translateX(100%);
  }
  .mobile-menu.active {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
  }
  .open .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  .open .line-2 {
    opacity: 0;
  }
  .open .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const nav = document.querySelector('[data-navbar]');
  const menuBtn = document.querySelector('#menu-btn');
  const mobileMenu = document.querySelector('#mobile-menu');
  const smartBack = document.querySelector<HTMLButtonElement>('#smart-back');

  const handleScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('border-white/5', 'bg-ash-main/85', 'backdrop-blur-md');
      nav?.classList.remove('border-transparent', 'bg-transparent');
    } else {
      nav?.classList.remove('border-white/5', 'bg-ash-main/85', 'backdrop-blur-md');
      nav?.classList.add('border-transparent', 'bg-transparent');
    }
  };

  smartBack?.addEventListener('click', () => {
    const cameFromSite = document.referrer && new URL(document.referrer).origin === location.origin;

    if (cameFromSite && history.length > 1) {
      history.back();
    } else {
      location.href = '/';
    }
  });

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.classList.toggle('open');
    mobileMenu?.classList.toggle('active');
    document.body.classList.toggle('overflow-hidden', isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuBtn?.classList.remove('open');
      mobileMenu?.classList.remove('active');
      document.body.classList.remove('overflow-hidden');
    });
  });

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
