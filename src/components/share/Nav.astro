---
import { APP_ROUTER } from '@/lib/constants';
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'main' | 'detail';
  color?: 'green' | 'blue' | 'accent';
  title?: string;
  links?: LinkKey[];
}

const topLevelRoutes = [
  APP_ROUTER.JOURNEY,
  APP_ROUTER.TALES,
  APP_ROUTER.FURTHER_TIME,
  APP_ROUTER.TRIP,
] as const;

const { links = topLevelRoutes.map((path) => path.replace('/', '')) as LinkKey[] } = Astro.props;

const LINK_MAP = {
  viaje: { name: 'Un año viajando', color: 'green' },
  relatos: { name: 'Relatos', color: 'accent' },
  'mas-aca-en-el-tiempo': { name: 'Más acá en el tiempo', color: 'blue' },
  trip: { name: 'Recorrido', color: 'accent' },
} as const;

type LinkKey = keyof typeof LINK_MAP;

const currentPath = Astro.url.pathname;
---

<nav
  data-navbar
  class="fixed inset-x-0 top-0 z-100 flex h-15 items-center justify-between border-b border-transparent bg-transparent px-6 transition-all duration-400 ease-in-out md:px-10"
>
  {
    currentPath === APP_ROUTER.HOME ? (
      <span class="font-fraunces text-ash-text z-50 text-lg font-semibold tracking-tight italic">
        el diario de mati
      </span>
    ) : (
      <div class="z-50 flex items-center gap-4">
        <a
          href={APP_ROUTER.HOME}
          class="font-fraunces text-ash-text z-50 text-lg font-semibold tracking-tight italic transition-opacity hover:opacity-70"
        >
          el diario de mati
        </a>
      </div>
    )
  }

  <div class="hidden items-center gap-8 md:flex">
    {
      links.map((link) => (
        <a
          href={`/${link}`}
          class={cn(
            'font-dm hover:text-accent-text text-xs tracking-widest uppercase underline-offset-4 transition-colors duration-200',
            currentPath === `/${link}` ? 'text-accent-text underline' : 'text-ash-hard no-underline'
          )}
        >
          {LINK_MAP[link]?.name || link}
        </a>
      ))
    }
    <span
      class="border-accent-main text-accent-text font-dm bg-accent-soft hover:bg-accent-glow cursor-pointer rounded-full border px-4 py-1.5 text-[11px] tracking-widest uppercase transition-colors"
    >
      Japón →
    </span>
  </div>

  <button
    id="menu-btn"
    class="relative z-120 flex cursor-pointer flex-col gap-1.5 md:hidden"
    aria-label="Menu"
    aria-expanded="false"
  >
    <div class="line-1 bg-ash-text h-0.5 w-6 origin-center transition-all duration-300"></div>
    <div class="line-2 bg-ash-text h-0.5 w-6 transition-all duration-300"></div>
    <div class="line-3 bg-ash-text h-0.5 w-6 origin-center transition-all duration-300"></div>
  </button>

  <div
    id="mobile-menu"
    class="mobile-menu bg-ash-main/98 fixed inset-0 z-110 flex flex-col items-center justify-center gap-8 backdrop-blur-xl md:hidden"
  >
    {
      links.map((link) => (
        <a
          href={`/${link}`}
          class={cn(
            'font-fraunces hover:text-accent-text text-2xl capitalize italic transition-colors',
            currentPath === `/${link}` ? 'text-accent-text underline' : 'text-ash-text no-underline'
          )}
        >
          {LINK_MAP[link]?.name || link}
        </a>
      ))
    }
    <span
      class="border-accent-main text-accent-text font-dm bg-accent-soft mt-4 rounded-full border px-8 py-3 text-sm tracking-widest uppercase transition-colors"
    >
      Japón →
    </span>
  </div>
</nav>

<style>
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateX(100%);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      visibility 0.4s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateX(0);
  }

  #menu-btn .line-1,
  #menu-btn .line-2,
  #menu-btn .line-3 {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  #menu-btn.open .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  #menu-btn.open .line-2 {
    opacity: 0;
  }

  #menu-btn.open .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const nav = document.querySelector('[data-navbar]');
  const menuBtn = document.querySelector('#menu-btn');
  const mobileMenu = document.querySelector('#mobile-menu');
  const smartBack = document.querySelector('#smart-back');

  const openMenu = () => {
    menuBtn?.classList.add('open');
    mobileMenu?.classList.add('active');

    menuBtn?.setAttribute('aria-expanded', 'true');

    document.body.classList.add('overflow-hidden');
  };

  const closeMenu = () => {
    menuBtn?.classList.remove('open');
    mobileMenu?.classList.remove('active');

    menuBtn?.setAttribute('aria-expanded', 'false');

    document.body.classList.remove('overflow-hidden');
  };

  const toggleMenu = () => {
    const isOpen = menuBtn?.classList.contains('open');

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  };

  const handleScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('border-white/5', 'bg-ash-main/85', 'backdrop-blur-md');
      nav?.classList.remove('border-transparent', 'bg-transparent');
    } else {
      nav?.classList.remove('border-white/5', 'bg-ash-main/85', 'backdrop-blur-md');
      nav?.classList.add('border-transparent', 'bg-transparent');
    }
  };

  smartBack?.addEventListener('click', () => {
    const cameFromSite = document.referrer && new URL(document.referrer).origin === location.origin;

    if (cameFromSite && history.length > 1) {
      history.back();
    } else {
      location.href = '/';
    }
  });

  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      closeMenu();
    }
  });

  window.addEventListener('scroll', handleScroll, { passive: true });

  handleScroll();
</script>
