---
import { APP_ROUTER } from '@/lib/constants';
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'main' | 'detail';
  color?: 'green' | 'blue' | 'accent';
  title?: string;
  links?: LinkKey[];
}

const topLevelRoutes = [
  APP_ROUTER.JOURNEY,
  APP_ROUTER.TALES,
  APP_ROUTER.FURTHER_TIME,
  APP_ROUTER.TRIP,
] as const;

const { links = topLevelRoutes.map((path) => path.replace('/', '')) as LinkKey[] } = Astro.props;

const LINK_MAP = {
  viaje: { name: 'Un año viajando', color: 'green' },
  relatos: { name: 'Relatos', color: 'accent' },
  'mas-aca-en-el-tiempo': { name: 'Más acá en el tiempo', color: 'blue' },
  trip: { name: 'Recorrido', color: 'accent' },
} as const;

type LinkKey = keyof typeof LINK_MAP;

const currentPath = Astro.url.pathname;
---

<header>
  <!-- NAVBAR -->
  <nav
    data-navbar
    class="bg-ash-main/30 fixed inset-x-0 top-0 z-30 flex h-15 items-center justify-between border-b border-transparent px-6 transition-all duration-400 ease-in-out md:px-10"
  >
    {
      currentPath === APP_ROUTER.HOME ? (
        <span class="font-fraunces text-ash-text text-lg font-semibold tracking-tight italic">
          el diario de mati
        </span>
      ) : (
        <a
          href={APP_ROUTER.HOME}
          class="font-fraunces text-ash-text text-lg font-semibold tracking-tight italic transition-opacity hover:opacity-70"
        >
          el diario de mati
        </a>
      )
    }

    <!-- DESKTOP -->
    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={`/${link}`}
            class={cn(
              'font-dm hover:text-accent-text text-xs tracking-widest uppercase underline-offset-4 transition-colors duration-200',
              currentPath === `/${link}` || currentPath.includes(link)
                ? 'text-accent-text underline'
                : 'text-ash-text no-underline'
            )}
          >
            {LINK_MAP[link]?.name || link}
          </a>
        ))
      }

      <span
        class="border-accent-main text-accent-text font-dm bg-accent-soft hover:bg-accent-glow cursor-pointer rounded-full border px-4 py-1.5 text-[11px] tracking-widest uppercase transition-colors"
      >
        Japón →
      </span>
    </div>
  </nav>

  <!-- MOBILE MENU BUTTON -->
  <button
    id="menu-btn"
    class="fixed top-5 right-6 z-50 flex cursor-pointer flex-col gap-1.5 md:hidden"
    aria-label="Menu"
    aria-expanded="false"
  >
    <div class="line-1 bg-ash-text h-0.5 w-6 origin-center"></div>
    <div class="line-2 bg-ash-text h-0.5 w-6 origin-center"></div>
    <div class="line-3 bg-ash-text h-0.5 w-6 origin-center"></div>
  </button>

  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="mobile-menu bg-ash-main/95 fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 backdrop-blur-xl md:hidden"
  >
    {
      links.map((link) => (
        <a
          href={`/${link}`}
          class={cn(
            'font-fraunces hover:text-accent-text text-2xl capitalize italic transition-colors',
            currentPath === `/${link}` ? 'text-accent-text underline' : 'text-ash-text no-underline'
          )}
        >
          {LINK_MAP[link]?.name || link}
        </a>
      ))
    }

    <span
      class="border-accent-main text-accent-text font-dm bg-accent-soft mt-4 rounded-full border px-8 py-3 text-sm tracking-widest uppercase transition-colors"
    >
      Japón →
    </span>
  </div>
</header>

<style>
  html.menu-open,
  body.menu-open {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-100%);

    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
  }

  #menu-btn .line-1,
  #menu-btn .line-2,
  #menu-btn .line-3 {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease,
      background-color 0.3s ease;
  }

  #menu-btn.open .line-1 {
    transform: translateY(8px) rotate(45deg);
  }

  #menu-btn.open .line-2 {
    opacity: 0;
  }

  #menu-btn.open .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }

  #menu-btn.open .line-1,
  #menu-btn.open .line-2,
  #menu-btn.open .line-3 {
    background-color: white;
  }
</style>

<script is:inline>
  if (!window.__navbar_initialized__) {
    window.__navbar_initialized__ = true;

    const nav = document.querySelector('[data-navbar]');
    const menuBtn = document.querySelector('#menu-btn');
    const mobileMenu = document.querySelector('#mobile-menu');
    const smartBack = document.querySelector('#smart-back');

    // =========================
    // VISUAL STATES
    // =========================

    const NAV_STYLES = {
      transparent: {
        add: ['border-transparent', 'bg-ash-main/30'],
        remove: ['border-white/5', 'bg-ash-main/85', 'backdrop-blur-md'],
      },

      solid: {
        add: ['border-white/5', 'bg-ash-main/85', 'backdrop-blur-md'],
        remove: ['border-transparent', 'bg-ash-main/30'],
      },
    };

    // =========================
    // HELPERS
    // =========================

    const applyClasses = (element, config) => {
      if (!element) return;

      element.classList.remove(...config.remove);
      element.classList.add(...config.add);
    };

    const setNavState = (state) => {
      applyClasses(nav, NAV_STYLES[state]);
    };

    const isMenuOpen = () => {
      return menuBtn?.classList.contains('open');
    };

    // =========================
    // MENU
    // =========================

    const openMenu = () => {
      menuBtn?.classList.add('open');
      mobileMenu?.classList.add('active');

      menuBtn?.setAttribute('aria-expanded', 'true');

      setNavState('solid');

      document.documentElement.classList.add('menu-open');
      document.body.classList.add('menu-open');
    };

    const closeMenu = () => {
      menuBtn?.classList.remove('open');
      mobileMenu?.classList.remove('active');

      menuBtn?.setAttribute('aria-expanded', 'false');

      document.documentElement.classList.remove('menu-open');
      document.body.classList.remove('menu-open');

      handleScroll();
    };

    const toggleMenu = () => {
      if (isMenuOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    // =========================
    // SCROLL
    // =========================

    const handleScroll = () => {
      if (isMenuOpen()) return;

      if (window.scrollY > 40) {
        setNavState('solid');
      } else {
        setNavState('transparent');
      }
    };

    // =========================
    // BACK BUTTON
    // =========================

    smartBack?.addEventListener('click', () => {
      const cameFromSite =
        document.referrer && new URL(document.referrer).origin === location.origin;

      if (cameFromSite && history.length > 1) {
        history.back();
      } else {
        location.href = '/';
      }
    });

    // =========================
    // EVENTS
    // =========================

    menuBtn?.addEventListener('click', toggleMenu);

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });

    window.addEventListener('scroll', handleScroll, {
      passive: true,
    });

    handleScroll();
  }
</script>
