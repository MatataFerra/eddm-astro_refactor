---
import { formatLongDate } from '@/lib/dates';
import { cn } from '@/lib/utils';

interface Props {
  date: Date | string;
  place?: string;
  timeZone?: string;
  /** `lg` abre la home; `md` abre cada día dentro de una lectura. */
  size?: 'lg' | 'md';
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
}

const { date, place, timeZone, size = 'md', as: Tag = 'p', class: className } = Astro.props;
const when = formatLongDate(date, timeZone);
---

<Tag
  class={cn(
    'font-bodoni text-right font-normal italic text-balance',
    size === 'lg'
      ? 'text-[clamp(40px,7.2vw,76px)] leading-[1.04] tracking-[-0.01em]'
      : 'text-[clamp(24px,3.4vw,32px)] leading-[1.15]',
    className
  )}
>
  {place && (
    <>
      <b class="font-semibold not-italic">{place}</b>,{' '}
    </>
  )}
  {when}
</Tag>
