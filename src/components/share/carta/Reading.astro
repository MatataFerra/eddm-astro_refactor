---
import Masthead from '@/components/share/carta/Masthead.astro';
import Dateline from '@/components/share/carta/Dateline.astro';
import Prose from '@/components/share/carta/Prose.astro';
import Signature from '@/components/share/carta/Signature.astro';
import LetterNav from '@/components/share/carta/LetterNav.astro';
import TextSize from '@/components/share/carta/TextSize.astro';
import Photo from '@/components/share/Photo.astro';
import { APP_ROUTER } from '@/lib/constants';
import type { ProcessedSection } from '@/lib/markdown/process';
import type { Neighbor } from '@/lib/adapters/reading-adapter';

interface Props {
  /** "Relato", "Poema", "Más acá en el tiempo" */
  kind: string;
  title: string;
  createdAt?: Date | string | null;
  place?: string | null;
  /** Epígrafe: la línea que acompaña al texto en los listados */
  epigraph?: string | null;
  cover?: string | null;
  verse?: boolean;
  sections: ProcessedSection[];
  prev: Neighbor;
  next: Neighbor;
}

const {
  kind,
  title,
  createdAt,
  place,
  epigraph,
  cover,
  verse = false,
  sections,
  prev,
  next,
} = Astro.props;

const blocks = await Promise.all(
  sections.map(async (section) => ({ ...section, html: await section.htmlContent }))
);
---

<Masthead />

<main class="pb-24">
  <header class="mx-auto max-w-[700px] px-[22px] pt-[clamp(32px,7vh,72px)]">
    <h1 class="font-bodoni text-[clamp(44px,8vw,88px)] leading-[1.02] font-semibold tracking-[-0.01em] text-balance">
      {title}
    </h1>
    <p class="text-muted mt-3 text-[17px]">{kind}</p>
    {createdAt && (
      <Dateline
        place={place ?? undefined}
        date={createdAt}
        timeZone="America/Argentina/Buenos_Aires"
        class="mt-12"
      />
    )}
    {epigraph && <p class="text-muted mt-10 text-[21px] leading-normal italic">{epigraph}</p>}
  </header>

  {cover && (
    <div class="mx-auto mt-12 max-w-[1100px] md:px-[22px]">
      <Photo
        src={cover}
        alt={title}
        width={1920}
        height={1280}
        sizes="(min-width: 1144px) 1100px, 100vw"
        priority
        class="aspect-[3/2] w-full object-cover"
      />
    </div>
  )}

  <div class="mx-auto mt-6 flex max-w-[700px] justify-end px-[22px]">
    <TextSize />
  </div>

  <article class="mx-auto mt-8 max-w-[700px] px-[22px]">
    {blocks.map((block) => (
      <>
        {block.title && (
          <h2 class="font-bodoni mt-14 mb-6 text-[clamp(24px,3.4vw,32px)] leading-[1.15] italic">
            {block.title}
          </h2>
        )}
        {block.html && (
          <Prose verse={verse}>
            <Fragment set:html={block.html} />
          </Prose>
        )}
        {block.media?.map((item) =>
          item.type === 'video' ? (
            <video
              src={item.src}
              poster={item.poster}
              controls
              playsinline
              preload="metadata"
              class="my-10 w-full"
            />
          ) : (
            <Photo
              src={item.src}
              alt={item.alt}
              width={item.width ?? 1200}
              height={item.height ?? 900}
              sizes="(min-width: 744px) 700px, 100vw"
              class="my-10 h-auto w-full"
            />
          )
        )}
      </>
    ))}
    <Signature />
  </article>

  <LetterNav
    {prev}
    {next}
    back={{ href: APP_ROUTER.LETTERS, label: 'Volver a todas las cartas' }}
  />
</main>
