---
import Masthead from '@/components/share/carta/Masthead.astro';
import Dateline from '@/components/share/carta/Dateline.astro';
import Prose from '@/components/share/carta/Prose.astro';
import Signature from '@/components/share/carta/Signature.astro';
import Photo from '@/components/share/Photo.astro';
import { APP_ROUTER } from '@/lib/constants';
import type { ProcessedSection } from '@/lib/markdown/process';
import type { Neighbor } from '@/lib/adapters/reading-adapter';

interface Props {
  /** "Relato", "Poema", "Más acá en el tiempo" */
  kind: string;
  title: string;
  createdAt?: Date | string | null;
  place?: string | null;
  /** Epígrafe: la línea que acompaña al texto en los listados */
  epigraph?: string | null;
  cover?: string | null;
  verse?: boolean;
  sections: ProcessedSection[];
  prev: Neighbor;
  next: Neighbor;
}

const {
  kind,
  title,
  createdAt,
  place,
  epigraph,
  cover,
  verse = false,
  sections,
  prev,
  next,
} = Astro.props;

const blocks = await Promise.all(
  sections.map(async (section) => ({ ...section, html: await section.htmlContent }))
);
---

<Masthead />

<main class="pb-24">
  <header class="mx-auto max-w-[700px] px-[22px]">
    <a
      href={`${APP_ROUTER.HOME}#cartas`}
      class="text-muted hover:text-lamp inline-block text-base no-underline transition-colors duration-200"
    >
      Todas las cartas
    </a>
    <h1 class="font-bodoni mt-10 text-[clamp(36px,5.6vw,58px)] leading-[1.05] font-semibold text-balance">
      {title}
    </h1>
    <p class="text-muted mt-2.5 text-base">{kind}</p>
    {createdAt && (
      <Dateline
        place={place ?? undefined}
        date={createdAt}
        timeZone="America/Argentina/Buenos_Aires"
        class="mt-12"
      />
    )}
    {epigraph && <p class="text-muted mt-10 text-[21px] leading-normal italic">{epigraph}</p>}
  </header>

  {cover && (
    <div class="mx-auto mt-12 max-w-[1100px] md:px-[22px]">
      <Photo
        src={cover}
        alt={title}
        width={1920}
        height={1280}
        sizes="(min-width: 1144px) 1100px, 100vw"
        priority
        class="aspect-[3/2] w-full object-cover"
      />
    </div>
  )}

  <article class="mx-auto mt-12 max-w-[700px] px-[22px]">
    {blocks.map((block) => (
      <>
        {block.title && (
          <h2 class="font-bodoni mt-14 mb-6 text-[clamp(24px,3.4vw,32px)] leading-[1.15] italic">
            {block.title}
          </h2>
        )}
        {block.html && (
          <Prose verse={verse}>
            <Fragment set:html={block.html} />
          </Prose>
        )}
        {block.media?.map((item) =>
          item.type === 'video' ? (
            <video
              src={item.src}
              poster={item.poster}
              controls
              playsinline
              preload="metadata"
              class="my-10 w-full"
            />
          ) : (
            <Photo
              src={item.src}
              alt={item.alt}
              width={item.width ?? 1200}
              height={item.height ?? 900}
              sizes="(min-width: 744px) 700px, 100vw"
              class="my-10 h-auto w-full"
            />
          )
        )}
      </>
    ))}
    <Signature />
  </article>

  {(prev || next) && (
    <div class="mx-auto mt-18 max-w-[700px] px-[22px]">
      <nav aria-label="Otras cartas" class="border-rule grid grid-cols-2 gap-6 border-t pt-6">
        {prev ? (
          <a href={prev.href} class="group no-underline">
            <span class="text-muted block text-[15px]">Anterior</span>
            <span class="group-hover:text-lamp font-bodoni text-xl leading-tight italic transition-colors duration-200">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={next.href} class="group text-right no-underline">
            <span class="text-muted block text-[15px]">Siguiente</span>
            <span class="group-hover:text-lamp font-bodoni text-xl leading-tight italic transition-colors duration-200">
              {next.title}
            </span>
          </a>
        )}
      </nav>
    </div>
  )}
</main>
