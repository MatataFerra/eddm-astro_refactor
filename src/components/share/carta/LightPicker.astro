---
// La luz de la página la pone la hora del lugar desde donde escribo; acá el lector puede quedarse
// con una de las cuatro. La elección queda guardada en el navegador y el script del <head> la
// aplica antes de pintar. El botón muestra el ícono de lo elegido sólo con CSS, así no salta.
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const OPTIONS = [
  { value: 'auto', label: 'La hora de allá' },
  { value: 'dawn', label: 'Amanecer' },
  { value: 'day', label: 'Día' },
  { value: 'dusk', label: 'Atardecer' },
  { value: 'night', label: 'Noche' },
] as const;

type Option = (typeof OPTIONS)[number]['value'];

const ICONS: Record<Option, string> = {
  auto: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 7.5V12l3 2',
  dawn: 'M3 19h18M7 19a5 5 0 0 1 10 0M12 3.5v6M9.5 6 12 3.5 14.5 6',
  day: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4',
  dusk: 'M3 19h18M7 19a5 5 0 0 1 10 0M12 3.5v6M9.5 7 12 9.5 14.5 7',
  night: 'M19.5 14.5A8 8 0 1 1 9.5 4.5a6.5 6.5 0 0 0 10 10Z',
};
---

<details class={cn('light-picker relative', className)} data-light-picker>
  <summary
    aria-label="Elegir la luz de la página"
    title="La luz de la página"
    class="border-rule hover:border-lamp hover:text-lamp grid size-11 cursor-pointer list-none place-items-center border transition-colors duration-200 select-none active:scale-95 [&::-webkit-details-marker]:hidden"
  >
    {OPTIONS.map(({ value }) => (
      <svg
        class={`icon icon-${value} size-5`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={ICONS[value]} />
      </svg>
    ))}
  </summary>

  <div
    role="group"
    aria-label="La luz de la página"
    class="border-rule bg-paper absolute top-full right-0 z-40 mt-2 w-52 border py-1.5 shadow-lg"
  >
    {OPTIONS.map(({ value, label }) => (
      <button
        type="button"
        data-light-option={value}
        aria-pressed="false"
        class="hover:text-lamp aria-pressed:text-lamp flex min-h-11 w-full items-center gap-3 px-3.5 text-left text-base transition-colors duration-200"
      >
        <svg
          class="size-5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={ICONS[value]} />
        </svg>
        {label}
      </button>
    ))}
  </div>
</details>

<style>
  .icon {
    display: none;
  }

  :global(:root:not([data-light])) .icon-auto,
  :global(:root[data-light='dawn']) .icon-dawn,
  :global(:root[data-light='day']) .icon-day,
  :global(:root[data-light='dusk']) .icon-dusk,
  :global(:root[data-light='night']) .icon-night {
    display: block;
  }
</style>

<script>
  import { LIGHT_KEY, SKY_EVENT, isPhase } from '@/lib/day-phases';

  const root = document.documentElement;
  const picker = document.querySelector<HTMLDetailsElement>('[data-light-picker]');
  const options = document.querySelectorAll<HTMLButtonElement>('[data-light-option]');

  function render() {
    const current = root.dataset.light ?? 'auto';
    for (const option of options) {
      option.setAttribute('aria-pressed', String(option.dataset.lightOption === current));
    }
  }

  function choose(value: string | undefined) {
    if (isPhase(value)) root.dataset.light = value;
    else delete root.dataset.light;
    try {
      if (isPhase(value)) localStorage.setItem(LIGHT_KEY, value);
      else localStorage.removeItem(LIGHT_KEY);
    } catch {
      // Sin almacenamiento la luz vale sólo para esta página
    }
    // El script del <head> vuelve a pintar con la luz nueva
    document.dispatchEvent(new CustomEvent(SKY_EVENT));
    render();
  }

  function close(focus = false) {
    if (!picker) return;
    picker.open = false;
    if (focus) picker.querySelector('summary')?.focus();
  }

  for (const option of options) {
    option.addEventListener('click', () => {
      choose(option.dataset.lightOption);
      close(true);
    });
  }

  document.addEventListener('click', (event) => {
    if (picker?.open && !picker.contains(event.target as Node)) close();
  });

  picker?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && picker.open) close(true);
  });

  render();
</script>
