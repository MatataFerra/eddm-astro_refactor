---
import { cn } from '@/lib/utils';

interface Props {
  /** Poemas: respeta los saltos de línea y va en itálica. */
  verse?: boolean;
  class?: string;
}

const { verse = false, class: className } = Astro.props;
---

<div class={cn('carta-prose', verse && 'is-verse', className)}>
  <slot />
</div>
