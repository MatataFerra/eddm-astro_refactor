---
interface Props {
  relato: {
    title: string;
    summary: string;
    cover: string;
    tag: string;
    href: string;
  };
}

const { relato } = Astro.props;
---

<a href={relato.href} class="reveal group block pb-16 no-underline outline-none">
  <div
    class="bg-ash-main group-hover:border-blue-main/40 group-hover:shadow-[0_32px_80px_rgba(0,0,0,0.6),0_0_0_1px_rgba(76, 168, 200, 0.25)] relative h-130 w-full overflow-hidden rounded-3xl border border-white/8 shadow-2xl transition-all duration-500 ease-out group-hover:-translate-y-1 md:h-120"
  >
    <!-- Imagen de Fondo con Zoom -->
    <img
      src={relato.cover}
      alt={relato.title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />

    <!-- Overlay Gradiente Editorial -->
    <div class="from-ash-main/95 via-ash-main/50 to-ash-main/15 absolute inset-0 bg-linear-to-r">
    </div>

    <!-- Contenido de la Card -->
    <div class="absolute inset-0 flex items-end p-8 md:p-[52px_60px]">
      <div class="max-w-140">
        <!-- Metadata -->
        <div class="mb-5 flex items-center gap-3">
          <div class="flex items-center gap-2">
            <div class="bg-blue-main/80 size-1.5 animate-pulse rounded-full"></div>
            <span class="font-dm text-blue-main text-[9px] font-medium tracking-[0.16em] uppercase">
              {relato.tag}
            </span>
          </div>
          <span class="font-dm text-ash-soft text-[11px] tracking-wider"> Destacado </span>
        </div>

        <!-- Texto -->
        <h2
          class="font-fraunces text-ash-text mb-5 text-[clamp(32px,5vw,56px)] leading-none font-extrabold tracking-tight"
        >
          {relato.title}
        </h2>
        <p
          class="font-dm text-ash-hard/90 mb-7 line-clamp-2 text-base leading-relaxed font-light md:text-[15px]"
        >
          {relato.summary}
        </p>

        <!-- Botón Call to Action -->
        <div
          class="bg-blue-main font-dm text-ash-main group-hover:bg-blue-soft inline-flex items-center gap-2.5 rounded-full px-6 py-3 text-[13px] font-medium tracking-wide transition-colors"
        >
          Leer relato
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </div>
      </div>
    </div>
  </div>
</a>
