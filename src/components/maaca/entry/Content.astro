---
import Article from '@/components/share/Article.astro';
import { APP_ROUTER } from '@/lib/constants';
import { processDiario } from '@/lib/markdown/process';
import { htmlContent } from '@/lib/utils';

interface Props {
  relato: {
    summary: string;
    description?: string;
    content: string;
  };
  nextRelato: { title: string; slug: string } | null;
}

const { relato, nextRelato } = Astro.props;
const section = await processDiario(relato.content);
---

<section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
  <div class="reveal mb-12">
    <blockquote
      class="border-blue-main bg-blue-main/20 mb-11 rounded-r-2xl border-l-3 p-7 backdrop-blur-sm md:p-8"
    >
      <p
        class="font-fraunces text-blue-soft text-lg leading-relaxed font-light tracking-tight italic md:text-xl"
      >
        "{relato.summary}"
      </p>
    </blockquote>
  </div>

  {
    relato.description && (
      <div
        class="reveal mb-12 rounded-2xl border border-white/7 bg-white/3 p-6"
        style="--delay: 0.1s"
      >
        <div class="font-dm text-ash-soft mb-2.5 text-[9px] font-medium tracking-[0.14em] uppercase">
          Resumen
        </div>
        <p class="font-dm text-ash-hard text-[15px] leading-relaxed font-light">
          {relato.description}
        </p>
      </div>
    )
  }

  <div class="reveal mb-11 flex items-center gap-4">
    <div class="h-px flex-1 bg-white/6"></div>
    <div class="bg-blue-main h-1.5 w-1.5 rounded-full"></div>
    <div class="h-px flex-1 bg-white/6"></div>
  </div>

  <Article htmlContent={htmlContent(section)} />

  <div class="reveal mt-16 flex flex-col items-center gap-4" style="--delay: 0.2s">
    <div class="flex gap-2">
      <div class="bg-ash-softest h-1 w-1 rounded-full"></div>
      <div class="bg-blue-main h-1 w-1 rounded-full"></div>
      <div class="bg-ash-softest h-1 w-1 rounded-full"></div>
    </div>
    <p class="font-fraunces text-ash-softest text-sm tracking-wider italic">fin del relato</p>
  </div>

  <nav
    class="reveal font-dm mt-20 flex items-center justify-between border-t border-white/6 pt-8 text-[13px]"
  >
    <a href={APP_ROUTER.FURTHER_TIME} class="text-ash-hard hover:text-blue-text transition-colors">
      ← Todos los relatos
    </a>

    {
      nextRelato && (
        <a
          href={APP_ROUTER.FURTHER_TIME_ARTICLE(nextRelato.slug)}
          class="text-ash-hard hover:text-blue-text text-right transition-colors"
        >
          {nextRelato.title} →
        </a>
      )
    }
  </nav>
</section>

<style is:global>
  article p:last-child {
    margin-bottom: 0;
  }
</style>
