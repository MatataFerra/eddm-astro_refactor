---
import { APP_ROUTER } from '@/lib/constants';
import type { ContentNavigate } from '@/lib/interfaces/share';

interface Props {
  item: ContentNavigate;
  delay?: number;
}

const { item, delay = 0 } = Astro.props;
---

<div class="reveal" style={`--delay: ${delay}s`}>
  <a href={APP_ROUTER.FURTHER_TIME_ARTICLE(item.slug)} class="group block no-underline">
    <div
      class="group-hover:border-blue-main/30 overflow-hidden rounded-2xl border border-white/[0.07] shadow-[0_4px_16px_rgba(0,0,0,0.3)] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[0_16px_40px_rgba(0,0,0,0.5),0_0_0_1px_rgba(76,168,200,0.11)]"
    >
      <div class="aspect-3/2 overflow-hidden">
        <img
          src={item.header?.url}
          alt={item.title}
          class="block h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          loading="lazy"
        />
      </div>

      <div class="border-blue-main/[0.14] bg-ash-main/95 border-t p-4 px-4.5 pb-5">
        <div class="mb-2 flex items-center gap-1.5">
          <div class="mb-2 flex items-center gap-2">
            <span
              class="text-blue-soft font-dm bg-blue-glow border-blue-main/60 rounded-full border px-2 py-0.75 text-[9px] tracking-[0.14em] uppercase"
            >
              mas acá
            </span>
          </div>
        </div>

        <h3
          class="font-fraunces text-blue-text text-base leading-snug font-semibold tracking-[-0.01em] not-italic"
        >
          {item.title}
        </h3>

        <div class="font-dm text-blue-soft mt-2.5 flex items-center gap-1 text-[11px]">
          Leer
          <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </div>
      </div>
    </div>
  </a>
</div>
