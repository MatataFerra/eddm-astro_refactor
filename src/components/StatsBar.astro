---
import { TRANSLATIONS } from '@/lib/constants';
import { getAllStats } from '@/lib/api/get-stats';
import type { Stats } from '@/lib/interfaces/stats';

const allStats = await getAllStats<Stats>();
---

<div class="reveal">
  <div
    class="mx-auto flex max-w-170 overflow-hidden rounded-2xl border border-white/8 bg-white/2.5 backdrop-blur-md"
  >
    {
      allStats?.data ? (
        Object.entries(allStats?.data).map(([key, value]: [string, number]) => (
          <div class="flex-1 border-r border-white/7 px-4 py-5 text-center last:hidden last:border-r-0 md:px-6 md:py-7 last:md:block">
            <div class="font-fraunces text-accent-text text-[44px] leading-none font-light tracking-[-0.03em] italic">
              {new Intl.NumberFormat('es-AR', { notation: 'compact' }).format(value)}
            </div>
            <div class="font-dm text-ash-soft mt-1.5 text-[11px] font-normal tracking-widest uppercase">
              {TRANSLATIONS.es[key]}
            </div>
          </div>
        ))
      ) : (
        <div class="flex-1 border-r border-white/7 px-4 py-5 text-center last:border-r-0 md:px-6 md:py-7">
          <p>No Stats</p>
        </div>
      )
    }
  </div>
</div>
