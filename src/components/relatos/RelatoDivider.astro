---
interface Props {
  label?: string;
}

const { label = 'Más relatos' } = Astro.props;
---

<div class="reveal mb-12 flex items-center gap-4 px-6 md:px-15">
  <div class="h-px flex-1 bg-white/6"></div>

  <span
    class="font-dm text-ash-softest text-[10px] font-medium tracking-[0.12em] whitespace-nowrap uppercase"
  >
    {label}
  </span>

  <div class="h-px flex-1 bg-white/6"></div>
</div>
