---
import { processRelato } from '@/lib/markdown/process';

interface Props {
  relato: {
    summary: string;
    description?: string;
    content: string;
  };
  nextRelato: { title: string; slug: string } | null;
}

const { relato, nextRelato } = Astro.props;
const htmlContent = processRelato(relato.content);
---

<section class="mx-auto max-w-2xl px-6 py-16 md:py-24">
  <div class="reveal mb-12">
    <blockquote
      class="border-accent-main bg-accent-soft rounded-r-2xl border-l-3 p-8 backdrop-blur-sm"
    >
      <p
        class="font-fraunces text-accent-text text-xl leading-relaxed font-light tracking-tight italic"
      >
        "{relato.summary}"
      </p>
    </blockquote>
  </div>

  {
    relato.description && (
      <div
        class="reveal mb-12 rounded-2xl border border-white/7 bg-white/3 p-6"
        style="--delay: 0.1s"
      >
        <div class="font-dm text-ash-soft mb-2.5 text-[9px] font-medium tracking-[0.14em] uppercase">
          Resumen
        </div>
        <p class="font-dm text-ash-hard text-[15px] leading-relaxed font-light">
          {relato.description}
        </p>
      </div>
    )
  }

  <div class="reveal mb-11 flex items-center gap-4">
    <div class="h-px flex-1 bg-white/6"></div>
    <div class="bg-accent-main h-1.5 w-1.5 rounded-full"></div>
    <div class="h-px flex-1 bg-white/6"></div>
  </div>

  <article
    class="prose prose-invert prose-p:font-serif prose-p:text-xl prose-p:leading-loose prose-p:text-ash-text/90 prose-p:mb-6 prose-strong:text-accent-text"
    set:html={htmlContent}
  />

  <div class="reveal mt-16 flex flex-col items-center gap-4" style="--delay: 0.2s">
    <div class="flex gap-2">
      <div class="bg-ash-softest h-1 w-1 rounded-full"></div>
      <div class="bg-accent-main h-1 w-1 rounded-full"></div>
      <div class="bg-ash-softest h-1 w-1 rounded-full"></div>
    </div>
    <p class="font-fraunces text-ash-softest text-sm tracking-wider italic">fin del relato</p>
  </div>

  <nav
    class="reveal font-dm mt-20 flex items-center justify-between border-t border-white/6 pt-8 text-[13px]"
  >
    <a href="/relatos" class="text-ash-hard hover:text-accent-text transition-colors">
      ← Todos los relatos
    </a>

    {
      nextRelato && (
        <a
          href={`/relatos/${nextRelato.slug}`}
          class="text-ash-hard hover:text-accent-text text-right transition-colors"
        >
          {nextRelato.title} →
        </a>
      )
    }
  </nav>
</section>

<style is:global>
  article p:last-child {
    margin-bottom: 0;
  }
</style>
