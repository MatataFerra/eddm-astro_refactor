---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import newsreaderFont from '@/assets/fonts/newsreader.woff2';
import bodoniItalicFont from '@/assets/fonts/bodoni-moda-italic.woff2';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import lightScript from '@/scripts/light.js?raw';

interface Props {
  title: string;
  /** Zona horaria del lugar desde donde escribo (IANA). Sin ella, la luz sigue la hora del visitante. */
  timeZone?: string;
}

const { title, timeZone } = Astro.props;
const fonts = [newsreaderFont, bodoniItalicFont];

// Astro no calcula el hash de los scripts `is:inline`: sin esto la CSP no deja correr la luz
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(lightScript).digest('base64')}`);

// El panel del cielo es sólo para desarrollo: en el build esta rama desaparece y el import también
const isDev = import.meta.env.NODE_ENV === 'development';
const SkyControls = isDev ? (await import('@/components/dev/SkyControls.astro')).default : null;
---

<!doctype html>
<html lang="es" data-tz={timeZone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f4f1" />
    <script is:inline set:html={lightScript} />
    {fonts.map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}

    <!-- La M de la firma. El SVG pasa a la luz de noche con el modo oscuro del sistema -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <div id="page-loader"></div>
    <slot />
    {SkyControls && <SkyControls />}
  </body>
</html>

<style is:global>
  #page-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--color-lamp);
    z-index: 9999;
    transition:
      width 0.3s ease,
      opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  // --- PAGE LOADER (solo /viaje/[slug]) ---
  function showLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.width = '30%';
    setTimeout(() => {
      loader.style.width = '60%';
    }, 400);
    setTimeout(() => {
      loader.style.width = '85%';
    }, 1000);
  }

  function hideLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader || loader.style.opacity !== '1') return;
    loader.style.width = '100%';
    setTimeout(() => {
      loader.style.opacity = '0';
      setTimeout(() => {
        loader.style.width = '0%';
      }, 300);
    }, 200);
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('a');
    if (!link || !link.href) return;
    if (link.origin !== location.origin) return;
    if (link.target === '_blank' || e.metaKey || e.ctrlKey) return;

    const url = new URL(link.href);
    if (/^\/viaje\/.+/.test(url.pathname)) {
      showLoader();
    }
  });

  window.addEventListener('pageshow', hideLoader);
</script>
