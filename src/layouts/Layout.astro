---
import '../styles/global.css';
import newsreaderFont from '@/assets/fonts/newsreader.woff2';
import bodoniItalicFont from '@/assets/fonts/bodoni-moda-italic.woff2';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  /** Zona horaria del lugar desde donde escribo (IANA). Sin ella, la luz sigue la hora del visitante. */
  timeZone?: string;
}

const { title, timeZone } = Astro.props;
const fonts = [newsreaderFont, bodoniItalicFont];
---

<!doctype html>
<html lang="es" data-tz={timeZone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f4f1" />
    <script is:inline>
      // La luz de la página es la de la hora donde estoy. Corre antes de pintar para no parpadear.
      (() => {
        const root = document.documentElement;
        const dark = matchMedia('(prefers-color-scheme: dark)');

        // El tamaño de letra que eligió el lector (src/lib/text-scale.ts)
        try {
          const scale = Number(localStorage.getItem('eddm_text_scale'));
          if (scale >= 0.9 && scale <= 1.4) root.style.setProperty('--text-scale', String(scale));
        } catch {}
        const phaseAt = (hour) =>
          hour < 6 ? 'night' : hour < 9 ? 'dawn' : hour < 18 ? 'day' : hour < 21 ? 'dusk' : 'night';

        function hourThere() {
          try {
            const parts = new Intl.DateTimeFormat('en-GB', {
              timeZone: root.dataset.tz || undefined,
              hour: 'numeric',
              minute: 'numeric',
              hourCycle: 'h23',
            }).formatToParts(new Date());
            const get = (type) => Number(parts.find((p) => p.type === type)?.value ?? 0);
            return get('hour') + get('minute') / 60;
          } catch {
            const now = new Date();
            return now.getHours() + now.getMinutes() / 60;
          }
        }

        function paint() {
          const hour = hourThere();
          let phase = phaseAt(hour);
          // La hora real de allá, aunque el modo oscuro cambie la luz
          root.dataset.hourPhase = phaseAt(hour);
          // Quien navega en modo oscuro nunca recibe la luz de día
          if (dark.matches && (phase === 'day' || phase === 'dawn')) phase = 'night';
          root.dataset.phase = phase;
          const paper = getComputedStyle(root).getPropertyValue('--color-paper').trim();
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', paper);
        }

        paint();
        dark.addEventListener('change', paint);
        setInterval(paint, 5 * 60 * 1000);
      })();
    </script>
    {fonts.map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <div id="page-loader"></div>
    <slot />
  </body>
</html>

<style is:global>
  #page-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--color-lamp);
    z-index: 9999;
    transition:
      width 0.3s ease,
      opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  // --- PAGE LOADER (solo /viaje/[slug]) ---
  function showLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.width = '30%';
    setTimeout(() => {
      loader.style.width = '60%';
    }, 400);
    setTimeout(() => {
      loader.style.width = '85%';
    }, 1000);
  }

  function hideLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader || loader.style.opacity !== '1') return;
    loader.style.width = '100%';
    setTimeout(() => {
      loader.style.opacity = '0';
      setTimeout(() => {
        loader.style.width = '0%';
      }, 300);
    }, 200);
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('a');
    if (!link || !link.href) return;
    if (link.origin !== location.origin) return;
    if (link.target === '_blank' || e.metaKey || e.ctrlKey) return;

    const url = new URL(link.href);
    if (/^\/viaje\/.+/.test(url.pathname)) {
      showLoader();
    }
  });

  window.addEventListener('pageshow', hideLoader);
</script>
