---
import '../styles/global.css';
import Nav from '@/components/share/Nav.astro';
import frauncesFont from '@/assets/fonts/fraunces.woff2';
import dmSansFont from '@/assets/fonts/dm-sans.woff2';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={dmSansFont} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body id="body-root">
    <div id="page-loader"></div>
    <Nav variant="main" data-navbar />
    <slot />
  </body>
</html>

<style is:global>
  html {
    visibility: visible;
  }
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
    transition-delay: var(--delay, 0s);
  }
  .reveal.visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #page-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--color-orange-main);
    z-index: 9999;
    transition:
      width 0.3s ease,
      opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 10px var(--color-orange-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0, rootMargin: '0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    revealObserver.observe(el);
  });

  // --- PAGE LOADER (solo /viaje/[slug]) ---
  function showLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.width = '30%';
    setTimeout(() => {
      loader.style.width = '60%';
    }, 400);
    setTimeout(() => {
      loader.style.width = '85%';
    }, 1000);
  }

  function hideLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader || loader.style.opacity !== '1') return;
    loader.style.width = '100%';
    setTimeout(() => {
      loader.style.opacity = '0';
      setTimeout(() => {
        loader.style.width = '0%';
      }, 300);
    }, 200);
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('a');
    if (!link || !link.href) return;
    if (link.origin !== location.origin) return;
    if (link.target === '_blank' || e.metaKey || e.ctrlKey) return;

    const url = new URL(link.href);
    if (/^\/viaje\/.+/.test(url.pathname)) {
      showLoader();
    }
  });

  window.addEventListener('pageshow', hideLoader);
</script>
