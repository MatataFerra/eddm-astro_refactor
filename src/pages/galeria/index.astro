---
import Layout from '@/layouts/Layout.astro';
import Masthead from '@/components/share/carta/Masthead.astro';
import MediaGrid from '@/components/share/carta/MediaGrid.astro';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import { getGallery } from '@/lib/adapters/gallery-adapter';
import { APP_ROUTER } from '@/lib/constants';
import type { Location } from '@/lib/interfaces/location';

export const prerender = true;

const [places, location] = await Promise.all([getGallery(), getCurrentLocation<Location>()]);

const total = places.reduce((sum, place) => sum + place.photos.length, 0);
const count = (n: number) => (n === 1 ? '1 foto' : `${n} fotos`);
const separator = (index: number) =>
  index < places.length - 2 ? ', ' : index === places.length - 2 ? ' y ' : '';
---

<Layout
  title="Las fotos | El diario de Mati"
  variant="carta"
  timeZone={location?.data?.metadata?.timeZone}
>
  <Masthead />
  <main class="pb-24">
    <header class="mx-auto max-w-[700px] px-[22px] pt-[clamp(32px,7vh,72px)]">
      <h1 class="font-bodoni text-[clamp(44px,8vw,88px)] leading-[1.02] font-semibold tracking-[-0.01em]">
        Las fotos
      </h1>
      {places.length > 0 && (
        <p class="mt-6 text-[21px] leading-normal text-pretty">
          {count(total)} de{' '}
          {places.map((place, index) => (
            <>
              <a
                href={`#${place.slug}`}
                class="hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
              >
                {place.name}
              </a>
              {separator(index)}
            </>
          ))}
          .
        </p>
      )}
    </header>

    {places.length > 0 ? (
      places.map((place) => (
        <section
          id={place.slug}
          aria-labelledby={`${place.slug}-titulo`}
          class="mt-[clamp(72px,12vh,128px)] scroll-mt-8"
        >
          <header class="mx-auto max-w-[1100px] px-[22px]">
            <h2
              id={`${place.slug}-titulo`}
              class="font-bodoni text-[clamp(36px,5.4vw,60px)] leading-[1.02] font-semibold tracking-[-0.01em] text-balance"
            >
              {place.name}
            </h2>
            <p class="text-muted mt-3 text-[17px]">{count(place.photos.length)}</p>
          </header>
          <MediaGrid items={place.photos} of={`de ${place.name}`} class="mt-8 max-w-[1100px]" />
        </section>
      ))
    ) : (
      <p class="text-muted mx-auto mt-12 max-w-[700px] px-[22px]">
        Las fotos no cargaron. Probá de nuevo en un rato.
      </p>
    )}

    <footer class="mx-auto mt-18 max-w-[700px] px-[22px]">
      <p class="border-rule flex flex-wrap justify-center gap-x-8 gap-y-2 border-t pt-6 text-[17px]">
        <a
          href={APP_ROUTER.TRIP}
          class="text-muted hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
        >
          El mapa del recorrido
        </a>
        <a
          href={APP_ROUTER.JOURNEY}
          class="text-muted hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
        >
          Volver al viaje
        </a>
      </p>
    </footer>
  </main>
</Layout>
