---
import Layout from '@/layouts/Layout.astro';
import Dateline from '@/components/share/carta/Dateline.astro';
import Signature from '@/components/share/carta/Signature.astro';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import { adaptLetters, LETTER_KIND_PHRASE } from '@/lib/adapters/home-adapter';
import { adaptTripWeek, sortTripEntries } from '@/lib/adapters/trip-adapter';
import { APP_ROUTER } from '@/lib/constants';
import { formatLongDate } from '@/lib/dates';
import type { ContentNavigate } from '@/lib/interfaces/share';
import type { Location } from '@/lib/interfaces/location';

// El link de la bio: siempre muestra lo último, así que se arma en cada visita
export const prerender = false;

type Link = { href: string; title: string; note: string; date?: string };

const [tales, poems, further, articles, location] = await Promise.all([
  getContentNavigate<ContentNavigate[]>('tales'),
  getContentNavigate<ContentNavigate[]>('poems'),
  getContentNavigate<ContentNavigate[]>('further'),
  getContentNavigate<ContentNavigate[]>('articles'),
  getCurrentLocation<Location>(),
]);

const place = location?.data ?? null;
const timeZone = place?.metadata?.timeZone;
const [latest] = adaptLetters({
  tales: tales?.data ?? [],
  poems: poems?.data ?? [],
  further: further?.data ?? [],
});
const lastWeekEntry = sortTripEntries(articles?.data ?? []).at(-1);
const lastWeek = lastWeekEntry ? adaptTripWeek(lastWeekEntry, []) : null;

const links: Link[] = [
  latest && {
    href: latest.href,
    title: latest.title,
    note: `Lo último que escribí, ${LETTER_KIND_PHRASE[latest.kind]}`,
    date: formatLongDate(latest.createdAt, 'America/Argentina/Buenos_Aires'),
  },
  lastWeek && {
    href: lastWeek.href,
    title: lastWeek.title,
    note: 'La última semana del viaje',
  },
  {
    href: APP_ROUTER.TALE('el-origen-del-miedo'),
    title: 'El origen del miedo',
    note: 'Un relato sobre cómo empezó el miedo en el hombre',
  },
  {
    href: APP_ROUTER.LETTERS,
    title: 'Todas las cartas',
    note: 'Relatos, poemas e historias, de lo más nuevo a lo más viejo',
  },
].filter((link): link is Link => Boolean(link));
---

<Layout title="Enlaces | El diario de Mati" variant="carta" {timeZone}>
  <main class="mx-auto max-w-[700px] px-[22px] pt-[clamp(32px,7vh,72px)] pb-24">
    <Dateline place={place?.name} date={new Date()} {timeZone} />

    <header class="mt-12">
      <h1 class="font-bodoni text-[clamp(44px,8vw,72px)] leading-[1.02] font-semibold tracking-[-0.01em] italic">
        <a
          href={APP_ROUTER.HOME}
          class="hover:text-lamp no-underline transition-colors duration-200"
        >
          El diario de Mati
        </a>
      </h1>
      <p class="text-muted mt-3 text-[19px] text-pretty">
        Relatos, poemas y un año de viaje escrito semana a semana.
      </p>
    </header>

    <ul class="border-rule mt-10 border-t">
      {links.map((link) => (
        <li class="border-rule border-b">
          <a
            href={link.href}
            class="group grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4.5 gap-y-1 py-4 no-underline"
          >
            <span class="group-hover:text-lamp text-[21px] leading-[1.3] transition-colors duration-200">
              {link.title}
            </span>
            {link.date && (
              <span class="text-muted col-start-2 row-start-1 text-right text-[15px] tabular-nums">
                {link.date}
              </span>
            )}
            <span class="text-muted col-start-1 text-[15px]">{link.note}</span>
          </a>
        </li>
      ))}
    </ul>

    <Signature />
  </main>
</Layout>
