---
import Layout from '@/layouts/Layout.astro';
import Masthead from '@/components/share/carta/Masthead.astro';
import Prose from '@/components/share/carta/Prose.astro';
import LetterList from '@/components/share/carta/LetterList.astro';
import Signature from '@/components/share/carta/Signature.astro';
import { loadLettersIndex } from '@/lib/adapters/letters-adapter';
import { APP_ROUTER } from '@/lib/constants';

export const prerender = true;

const LATEST = 5;

const { letters, timeZone } = await loadLettersIndex(null);
const latest = letters.slice(0, LATEST);
---

<Layout title="Página no encontrada | El diario de Mati" variant="carta" {timeZone}>
  <Masthead />

  <main class="mx-auto max-w-[700px] px-[22px] pt-[clamp(32px,7vh,72px)] pb-24">
    <h1 class="font-bodoni text-[clamp(44px,8vw,88px)] leading-[1.02] font-semibold tracking-[-0.01em] text-balance">
      Esta carta no llegó
    </h1>

    <Prose class="mt-8">
      <p>
        Puede que el enlace esté roto o que todavía no la haya escrito.{' '}
        {latest.length > 0 && 'Mientras tanto, estas son las últimas que mandé.'}
      </p>
    </Prose>

    {latest.length > 0 && (
      <div class="mt-8">
        <LetterList letters={latest} />
      </div>
    )}

    <p class="text-muted mt-6 text-[17px]">
      También podés{' '}
      <a
        href={APP_ROUTER.HOME}
        class="text-lamp decoration-lamp/40 hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
      >
        volver al inicio
      </a>{' '}
      o{' '}
      <a
        href={APP_ROUTER.LETTERS}
        class="text-lamp decoration-lamp/40 hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
      >
        ver todas las cartas
      </a>
      .
    </p>

    <Signature />
  </main>
</Layout>
