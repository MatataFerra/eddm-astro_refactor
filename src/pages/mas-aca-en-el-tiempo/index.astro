---
import Layout from '@/layouts/Layout.astro';
import LettersIndex from '@/components/cartas/LettersIndex.astro';
import { loadLettersIndex } from '@/lib/adapters/letters-adapter';

export const prerender = true;

const { letters, tripWeeks, timeZone } = await loadLettersIndex('historia');
---

<Layout title="Más acá en el tiempo | El diario de Mati" variant="carta" {timeZone}>
  <LettersIndex
    title="Más acá en el tiempo"
    intro="Historias que pasaron recientemente y que quizás no sean correlativas."
    {letters}
    kind="historia"
    {tripWeeks}
  />
</Layout>
