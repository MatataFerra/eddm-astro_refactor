---
import Layout from '@/layouts/Layout.astro';
import LettersIndex from '@/components/cartas/LettersIndex.astro';
import { loadLettersIndex } from '@/lib/adapters/letters-adapter';

export const prerender = true;

const { letters, tripWeeks, timeZone } = await loadLettersIndex('poema');
---

<Layout title="Poemas | El diario de Mati" variant="carta" {timeZone}>
  <LettersIndex
    title="Poemas"
    intro="Versos sueltos escritos en el camino."
    {letters}
    kind="poema"
    {tripWeeks}
  />
</Layout>
