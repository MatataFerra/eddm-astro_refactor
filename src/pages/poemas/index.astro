---
import Layout from '@/layouts/Layout.astro';
import PoemasHero from '@/components/poemas/PoemasHero.astro';
import PoemaFeatured from '@/components/poemas/PoemaFeatured.astro';
import PoemaList from '@/components/poemas/PoemaList.astro';
import { splitFeatured, toPoema } from '@/lib/poems';
import { getContentNavigatePoems } from '@/lib/api/get-content-navigate';
import type { ContentNavigate } from '@/lib/interfaces/share';

const data = await getContentNavigatePoems<ContentNavigate[]>();

const poemas = (data?.data ?? []).map((item) => toPoema(item));
const { featured, rest } = splitFeatured(poemas);
---

<Layout title="Poemas — El diario de Mati">
  <PoemasHero />

  {
    featured && (
      <section class="mx-auto max-w-250 px-6 pb-14 md:px-12">
        <PoemaFeatured poema={featured} />
      </section>
    )
  }

  {rest.length > 0 && <PoemaList poemas={rest} />}
</Layout>
