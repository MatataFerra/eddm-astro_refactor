---
import Layout from '@/layouts/Layout.astro';
import Masthead from '@/components/share/carta/Masthead.astro';
import TripNext from '@/components/viaje/carta/TripNext.astro';
import TripPlaces from '@/components/viaje/carta/TripPlaces.astro';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import { adaptTripBundles, getTripWeeks } from '@/lib/adapters/trip-adapter';
import { APP_ROUTER } from '@/lib/constants';
import { formatMonthRange } from '@/lib/dates';
import type { Location } from '@/lib/interfaces/location';

export const prerender = true;

const [tripWeeks, location] = await Promise.all([getTripWeeks(), getCurrentLocation<Location>()]);

const weeks = tripWeeks.map(({ week }) => week);
const bundles = adaptTripBundles(weeks);
const dated = weeks.filter((week) => week.from);
const span = dated.length ? formatMonthRange(dated[0].from!, dated.at(-1)!.to) : null;
---

<Layout title="El viaje | El diario de Mati" timeZone={location?.data?.metadata?.timeZone}>
  <Masthead />
  <main class="pb-24">
    <header class="mx-auto max-w-[700px] px-[22px] pt-[clamp(32px,7vh,72px)]">
      <h1 class="font-bodoni text-[clamp(44px,8vw,88px)] leading-[1.02] font-semibold tracking-[-0.01em]">
        El viaje
      </h1>
      <p class="mt-6 text-[21px] leading-normal text-pretty">
        Lo escribí semana a semana{span && <>, de {span}</>}: {weeks.length} cartas, agrupadas por
        el lugar donde estaba viviendo.
      </p>
      {weeks.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <TripNext {weeks} />
          <p
            data-trip-progress
            data-slugs={JSON.stringify(weeks.map((week) => week.slug))}
            hidden
            class="text-muted text-[17px]"
          ></p>
        </div>
      )}
      <p class="text-muted mt-8 text-[17px] leading-relaxed text-pretty">
        El viaje empezó antes y siguió después de estas semanas:{' '}
        <a
          href={APP_ROUTER.TRIP}
          class="hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
        >
          el recorrido completo
        </a>
        , con cada lugar en el mapa, y{' '}
        <a
          href={APP_ROUTER.GALLERY}
          class="hover:text-lamp decoration-rule hover:decoration-lamp underline underline-offset-4 transition-colors duration-200"
        >
          las fotos, por lugar
        </a>
        .
      </p>
    </header>

    {bundles.length > 0 ? (
      <TripPlaces {bundles} />
    ) : (
      <p class="text-muted mx-auto mt-12 max-w-[700px] px-[22px]">
        Las cartas del viaje no cargaron. Probá de nuevo en un rato.
      </p>
    )}
  </main>
</Layout>

<script>
  import { readWeeks } from '@/lib/store/viaje-store';

  const progress = document.querySelector<HTMLElement>('[data-trip-progress]');
  if (progress) {
    const slugs: string[] = JSON.parse(progress.dataset.slugs ?? '[]');
    readWeeks.subscribe((read) => {
      const done = slugs.filter((slug) => read.includes(slug)).length;
      progress.hidden = done === 0;
      progress.textContent = `Llevás ${done} de ${slugs.length} leídas.`;
    });
  }
</script>
