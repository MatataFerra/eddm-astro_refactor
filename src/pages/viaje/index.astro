---
import Layout from '@/layouts/Layout.astro';
import Tracker from '@/components/viaje/Tracker.astro';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import type { ContentNavigate } from '@/lib/interfaces/share';
import { adaptArticlesToMeses } from '@/lib/adapters/viaje-adapter';

export const prerender = true;

const articles = await getContentNavigate<ContentNavigate[]>('articles');
const mesesData = adaptArticlesToMeses(articles?.data || []);
---

<Layout
  title="Un año viajando — El diario de Mati"
  description="De febrero de 2024 a febrero de 2025, una entrada por semana."
>
  <main>
    <Tracker months={mesesData} />
  </main>
</Layout>
