---
import Layout from '@/layouts/Layout.astro';
import Week from '@/components/viaje/carta/Week.astro';
import { getArticleContentFromNotion } from '@/lib/api/get-notion-content';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import {
  adaptTripWeek,
  adaptWeekDays,
  adaptWeekPlaces,
  sortTripEntries,
} from '@/lib/adapters/trip-adapter';
import { processDiario } from '@/lib/markdown/process';
import { APP_ROUTER } from '@/lib/constants';
import type { Neighbor } from '@/lib/adapters/reading-adapter';
import type { ContentBySlug, ContentNavigate } from '@/lib/interfaces/share';
import type { Article } from '@/lib/interfaces/articles';
import type { Location } from '@/lib/interfaces/location';

const { slug } = Astro.params;

const [response, articles, location] = await Promise.all([
  getArticleContentFromNotion<ContentBySlug<Article>>({ query: slug }),
  getContentNavigate<ContentNavigate[]>('articles'),
  getCurrentLocation<Location>(),
]);

if (!response?.data) return Astro.redirect('/404');

const article = response.data;
const entries = sortTripEntries(articles?.data ?? []);
const position = entries.findIndex((entry) => entry.slug === article.slug);
const toNeighbor = (entry: ContentNavigate | undefined): Neighbor =>
  entry ? { title: entry.title, href: APP_ROUTER.ARTICLE(entry.slug) } : null;

const sections = await processDiario(article.md_content);
const { days, week } = await adaptWeekDays(
  sections,
  adaptTripWeek(article, adaptWeekPlaces(article.geolocations))
);
---

<Layout
  title={`${article.title} | El diario de Mati`}
  timeZone={location?.data?.metadata?.timeZone}
>
  <Week
    {week}
    {days}
    summary={article.summary}
    prev={position > 0 ? toNeighbor(entries[position - 1]) : null}
    next={position >= 0 ? toNeighbor(entries[position + 1]) : null}
  />
</Layout>
