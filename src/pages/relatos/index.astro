---
import Layout from '@/layouts/Layout.astro';
import LettersIndex from '@/components/cartas/LettersIndex.astro';
import { loadLettersIndex } from '@/lib/adapters/letters-adapter';

export const prerender = true;

const { letters, tripWeeks, timeZone } = await loadLettersIndex('relato');
---

<Layout title="Relatos | El diario de Mati" {timeZone}>
  <LettersIndex
    title="Relatos"
    intro="Historias que nacieron en cuadernos, servilletas y apps de notas alrededor del mundo."
    {letters}
    kind="relato"
    {tripWeeks}
  />
</Layout>
