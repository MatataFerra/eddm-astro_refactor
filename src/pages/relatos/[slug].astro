---
import Layout from '@/layouts/Layout.astro';
import Reading from '@/components/share/carta/Reading.astro';
import { getContentNavigate } from '@/lib/api/get-content-navigate';
import { getCurrentLocation } from '@/lib/api/get-current-location';
import { getArticleContentFromNotion } from '@/lib/api/get-notion-content';
import { withNeighbors, type Neighbor } from '@/lib/adapters/reading-adapter';
import { APP_ROUTER } from '@/lib/constants';
import { processDiario } from '@/lib/markdown/process';
import type { ContentBySlug, ContentNavigate } from '@/lib/interfaces/share';
import type { Article } from '@/lib/interfaces/articles';
import type { Location } from '@/lib/interfaces/location';

export const prerender = true;

export async function getStaticPaths() {
  const response = await getContentNavigate<ContentNavigate[]>('tales');

  return withNeighbors(response?.data ?? [], APP_ROUTER.TALE).map(({ slug, prev, next }) => ({
    params: { slug },
    props: { prev, next },
  }));
}

interface Props {
  prev: Neighbor;
  next: Neighbor;
}

const { slug } = Astro.params;
const { prev, next } = Astro.props;

const [response, location] = await Promise.all([
  getArticleContentFromNotion<ContentBySlug<Article>>({ query: slug }),
  getCurrentLocation<Location>(),
]);

if (!response || !response.data) return Astro.redirect('/404');

const entry = response.data;
const sections = await processDiario(entry.md_content, entry.type);
const extra = {
  epigraph: entry.summary,
  cover: entry.header?.url,
  verse: entry.type === 'poem',
};
---

<Layout
  title={`${entry.title} | El diario de Mati`}
  variant="carta"
  timeZone={location?.data?.metadata?.timeZone}
>
  <Reading
    kind="Relato"
    title={entry.title}
    createdAt={entry.createdAt}
    {sections}
    {prev}
    {next}
    {...extra}
  />
</Layout>
